<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>

    <!--
        Collection rows provide their own rounded tap and selected visuals.
        Keeping native item selection disabled prevents platform list cells from
        drawing a rectangular pressed/selected background behind those visuals.
    -->
    <Style TargetType="CollectionView">
        <Setter Property="SelectionMode" Value="None" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="1.06" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>

    <Style x:Key="BodyMuted" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}"
                    Offset="0,6"
                    Opacity="0.95"
                    Radius="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardSurface" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <Style x:Key="CardShadowLayer" TargetType="Border">
        <Setter Property="InputTransparent" Value="True" />
        <Setter Property="TranslationY" Value="6" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
    </Style>

    <Style x:Key="SoftCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style x:Key="NavLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
    </Style>

    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
    </Style>

    <Style x:Key="SelectedNavIcon" TargetType="Path" BasedOn="{StaticResource NavIcon}">
        <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>

    <Style x:Key="NavTab" TargetType="Border">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 23" />
    </Style>

    <Style x:Key="SelectedNavLabel" TargetType="Label" BasedOn="{StaticResource NavLabel}">
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style x:Key="OptionCard" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>

    <Style x:Key="SelectedOptionCard" TargetType="Border" BasedOn="{StaticResource OptionCard}">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentTint}" />
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style x:Key="CategorySegmentTab" TargetType="Border">
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 11" />
    </Style>

    <Style x:Key="SelectedCategorySegmentTab" TargetType="Border" BasedOn="{StaticResource CategorySegmentTab}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark=#242426}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DividerLight}, Dark=#353539}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}"
                    Offset="0,2"
                    Opacity="0.18"
                    Radius="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CategorySegmentLabel" TargetType="Label" BasedOn="{StaticResource BodyMuted}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SelectedCategorySegmentLabel" TargetType="Label" BasedOn="{StaticResource CategorySegmentLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Style>
</ResourceDictionary>
