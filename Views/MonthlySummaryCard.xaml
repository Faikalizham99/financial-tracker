<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.MonthlySummaryCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:FinancialTracker.Helpers">

    <Grid Margin="0,0,0,6">
        <Border Style="{StaticResource CardShadowLayer}" />
        <Border Style="{StaticResource CardSurface}" Padding="20,18">
            <VerticalStackLayout Spacing="17">
                <Grid ColumnDefinitions="23,*,50,34" ColumnSpacing="8">
                    <Path
                        WidthRequest="23"
                        HeightRequest="23"
                        Data="M 5,5 L 19,5 Q 21,5 21,7 L 21,19 Q 21,21 19,21 L 5,21 Q 3,21 3,19 L 3,7 Q 3,5 5,5 Z M 3,10 L 21,10 M 8,3 L 8,7 M 16,3 L 16,7 M 8,14 L 10,14 M 13,14 L 15,14 M 8,18 L 10,18 M 13,18 L 15,18"
                        Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                        StrokeThickness="1.8"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        Fill="Transparent"
                        Aspect="Uniform"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="SummaryMonthLabel"
                        Grid.Column="1"
                        Text="September 2026"
                        FontFamily="OpenSansSemibold"
                        FontSize="21"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        VerticalTextAlignment="Center" />
                    <Border
                        x:Name="InvestmentToggleButton"
                        Grid.Column="2"
                        WidthRequest="50"
                        HeightRequest="28"
                        Padding="2"
                        BackgroundColor="{DynamicResource Accent}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        VerticalOptions="Center"
                        helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                        SemanticProperties.Description="Investment included in summary totals. Tap to exclude it.">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInvestmentToggleTapped" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Border
                                x:Name="InvestmentToggleThumb"
                                WidthRequest="24"
                                HeightRequest="24"
                                Padding="2"
                                TranslationX="22"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                                <Grid WidthRequest="20" HeightRequest="20">
                                    <Path
                                        x:Name="InvestmentToggleIcon"
                                        Data="M 4,4 L 4,18 L 20,18 M 7,14 L 11,10 L 14,13 L 20,6 M 15,6 L 20,6 L 20,11"
                                        Stroke="{DynamicResource Accent}"
                                        StrokeThickness="2"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Fill="Transparent"
                                        Aspect="Uniform" />
                                    <Path
                                        x:Name="InvestmentExclusionSlash"
                                        IsVisible="False"
                                        Data="M 5,4 L 19,20"
                                        Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                        StrokeThickness="2.2"
                                        StrokeLineCap="Round"
                                        Fill="Transparent"
                                        Aspect="Uniform" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="TransactionLockButton"
                        Grid.Column="3"
                        WidthRequest="34"
                        HeightRequest="34"
                        Padding="7"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 17"
                        VerticalOptions="Center"
                        helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                        SemanticProperties.Description="Transactions locked. Tap to allow editing and deletion.">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTransactionLockTapped" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Grid
                                x:Name="LockedTransactionState"
                                VerticalOptions="Center">
                                <Path
                                    WidthRequest="18"
                                    HeightRequest="20"
                                    Data="M 6,10 L 6,7 A 6,6 0 0 1 18,7 L 18,10 M 5,10 L 19,10 L 19,21 L 5,21 Z M 12,14 L 12,17"
                                    Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                    StrokeThickness="2"
                                    StrokeLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Fill="Transparent"
                                    Aspect="Uniform" />
                            </Grid>
                            <Grid
                                x:Name="UnlockedTransactionState"
                                IsVisible="False"
                                VerticalOptions="Center">
                                <Path
                                    WidthRequest="19"
                                    HeightRequest="19"
                                    Data="M 4,20 L 8,19 L 19,8 L 16,5 L 5,16 Z M 14,7 L 17,10"
                                    Stroke="{DynamicResource Accent}"
                                    StrokeThickness="2"
                                    StrokeLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Fill="Transparent"
                                    Aspect="Uniform" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <Label
                        x:Name="SummaryAvailableAmountLabel"
                        Text="RM 0.00"
                        FontFamily="OpenSansRegular"
                        FontSize="40"
                        FontAutoScalingEnabled="False"
                        CharacterSpacing="-0.5"
                        LineBreakMode="NoWrap"
                        VerticalTextAlignment="Center" />
                    <VerticalStackLayout
                        x:Name="TransactionCountPanel"
                        Grid.Column="1"
                        IsVisible="False"
                        Spacing="3"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <Label Text="TOTAL TRANSACTIONS" Style="{StaticResource SectionLabel}" FontSize="10" HorizontalTextAlignment="End" />
                        <Label x:Name="SummaryTransactionCountLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="30" FontAutoScalingEnabled="False" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout Spacing="10">
                    <Label
                        x:Name="SummaryAvailableCaptionLabel"
                        Text="Available for September"
                        Style="{StaticResource BodyMuted}"
                        FontSize="17"
                        VerticalTextAlignment="Center" />
                    <Grid x:Name="AmountVisibilityButton" WidthRequest="28" HeightRequest="24" VerticalOptions="Center" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAmountVisibilityTapped" />
                        </Grid.GestureRecognizers>
                        <Path
                            x:Name="OpenEyeIcon"
                            WidthRequest="24"
                            HeightRequest="18"
                            Data="M 2,10 Q 6,4 12,4 Q 18,4 22,10 Q 18,16 12,16 Q 6,16 2,10 Z M 9,10 A 3,3 0 1 0 15,10 A 3,3 0 1 0 9,10"
                            Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                            StrokeThickness="1.8"
                            Fill="Transparent"
                            Aspect="Uniform"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Path
                            x:Name="ClosedEyeIcon"
                            IsVisible="False"
                            WidthRequest="24"
                            HeightRequest="20"
                            Data="M 3,4 L 21,20 M 5,8 Q 8,4 12,4 Q 18,4 22,10 Q 20,13 17,15 M 3,10 Q 5,13 8,15 Q 11,17 15,16"
                            Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                            StrokeThickness="1.8"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Fill="Transparent"
                            Aspect="Uniform"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                <Grid ColumnDefinitions="*,1,*" ColumnSpacing="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="TOTAL INCOME" Style="{StaticResource SectionLabel}" FontSize="11" />
                        <HorizontalStackLayout Spacing="8">
                            <Label x:Name="SummaryIncomeAmountLabel" Text="RM 0.00" FontFamily="OpenSansSemibold" FontSize="21" FontAutoScalingEnabled="False" VerticalTextAlignment="Center" />
                            <Path
                                WidthRequest="20"
                                HeightRequest="20"
                                Data="M 4,18 L 18,4 M 9,4 L 18,4 L 18,13"
                                Stroke="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"
                                Aspect="Uniform"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                        <Label Text="TOTAL EXPENSE" Style="{StaticResource SectionLabel}" FontSize="11" />
                        <HorizontalStackLayout Spacing="8">
                            <Label x:Name="SummaryExpenseAmountLabel" Text="RM 0.00" FontFamily="OpenSansSemibold" FontSize="21" FontAutoScalingEnabled="False" VerticalTextAlignment="Center" />
                            <Path
                                WidthRequest="20"
                                HeightRequest="20"
                                Data="M 4,4 L 18,18 M 9,18 L 18,18 L 18,9"
                                Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"
                                Aspect="Uniform"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout x:Name="BudgetProgressSection" IsVisible="False" Spacing="10">
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout
                            x:Name="BudgetExplanationButton"
                            Spacing="6"
                            VerticalOptions="Center"
                            helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                            SemanticProperties.Description="Show how net spending is calculated">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBudgetExplanationTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="NET SPENDING / BUDGET" Style="{StaticResource SectionLabel}" FontSize="10" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                            <Border
                                WidthRequest="16"
                                HeightRequest="16"
                                Padding="0"
                                BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                StrokeThickness="1.4"
                                StrokeShape="RoundRectangle 8"
                                VerticalOptions="Center">
                                <Label
                                    Text="i"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="10"
                                    FontAutoScalingEnabled="False"
                                    TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label x:Name="BudgetUsagePercentageLabel" Grid.Column="1" Text="0% USED" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{DynamicResource Accent}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                    </Grid>
                    <Border
                        x:Name="BudgetExplanationPanel"
                        IsVisible="False"
                        Opacity="0"
                        Padding="12,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="HOW IT IS CALCULATED" Style="{StaticResource SectionLabel}" FontSize="9" />
                            <Label
                                Text="Net spending = expenses − Refund, Cashback and Other income. Salary and Bonus are excluded. Investment follows the switch above. A surplus does not use your budget."
                                Style="{StaticResource BodyMuted}"
                                FontSize="12"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                    <Label x:Name="BudgetUsageAmountLabel" Text="RM 0.00 / RM 0.00" FontFamily="OpenSansSemibold" FontSize="22" FontAutoScalingEnabled="False" LineBreakMode="NoWrap" MaxLines="1" />
                    <ProgressBar
                        x:Name="BudgetUsageProgress"
                        HeightRequest="8"
                        Progress="0"
                        ProgressColor="{DynamicResource Accent}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <HorizontalStackLayout
                            x:Name="BudgetSurplusPanel"
                            IsVisible="False"
                            Spacing="6"
                            VerticalOptions="Center">
                            <Border
                                WidthRequest="17"
                                HeightRequest="17"
                                Padding="0"
                                BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 9">
                                <Label
                                    Text="+"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    FontAutoScalingEnabled="False"
                                    TextColor="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                            <Label
                                x:Name="BudgetSurplusLabel"
                                Text="RM 0.00 surplus"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label
                            x:Name="BudgetUsageRemainingLabel"
                            Grid.Column="1"
                            Text="RM 0.00 left"
                            Style="{StaticResource BodyMuted}"
                            FontSize="12"
                            HorizontalTextAlignment="End"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
