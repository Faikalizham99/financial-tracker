<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.TransactionStatisticsDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:FinancialTracker.Helpers"
    xmlns:models="clr-namespace:FinancialTracker.Models"
    xmlns:views="clr-namespace:FinancialTracker.Views"
    IsVisible="False">

    <Grid
        x:Name="DetailRoot"
        RowDefinitions="Auto,*"
        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
        SizeChanged="OnDetailRootSizeChanged">

        <Grid
            x:Name="DetailHeader"
            Padding="{OnIdiom Phone='18,18,18,12', Tablet='24,22,24,14', Desktop='24,22,24,14'}"
            ColumnDefinitions="44,*,Auto"
            ColumnSpacing="12"
            HorizontalOptions="Center">
            <Border
                WidthRequest="44"
                HeightRequest="44"
                Padding="11"
                Style="{StaticResource Pill}"
                helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                SemanticProperties.Description="Back to statistics">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <Path
                    Data="M 15,4 L 7,12 L 15,20"
                    Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    StrokeThickness="2.3"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Fill="Transparent"
                    Aspect="Uniform" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label
                    Text="Details"
                    Style="{StaticResource PageTitle}"
                    FontSize="{OnIdiom Phone=27, Tablet=31, Desktop=31}"
                    FontAutoScalingEnabled="False"
                    LineBreakMode="NoWrap" />
                <Label Text="Transactions behind this statistic" Style="{StaticResource BodyMuted}" FontSize="12" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Padding="12,8" Style="{StaticResource Pill}" VerticalOptions="Center">
                <Label Text="{Binding MonthLabel}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{DynamicResource Accent}" LineBreakMode="NoWrap" />
            </Border>
        </Grid>

        <ScrollView x:Name="DetailScrollView" Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                x:Name="DetailContent"
                Padding="{OnIdiom Phone='18,2,18,38', Tablet='24,2,24,44', Desktop='24,2,24,44'}"
                Spacing="18"
                HorizontalOptions="Center">

                <Border Style="{StaticResource Card}" Padding="{OnIdiom Phone=17, Tablet=20, Desktop=20}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="13">
                            <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                                <Image Source="{Binding IconAsset}" WidthRequest="52" HeightRequest="52" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="18" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="{Binding ScopeLabel}" Style="{StaticResource BodyMuted}" FontSize="11" />
                            </VerticalStackLayout>
                            <Label
                                x:Name="DetailTotalLabel"
                                Grid.Column="2"
                                Text="{Binding TotalText}"
                                FontFamily="OpenSansSemibold"
                                FontSize="{OnIdiom Phone=18, Tablet=21, Desktop=21}"
                                LineBreakMode="NoWrap"
                                VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding ChartTitle}" Style="{StaticResource SectionLabel}" />
                                <Label Text="Amounts are combined for each period" Style="{StaticResource BodyMuted}" FontSize="11" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource SoftCard}" Padding="3" VerticalOptions="Center">
                                <Grid ColumnDefinitions="48,48" ColumnSpacing="3">
                                    <Border x:Name="DailyRangeButton" Style="{StaticResource SelectedCategorySegmentTab}" Padding="8,6" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="Daily" /></Border.GestureRecognizers>
                                        <Label x:Name="DailyRangeLabel" Text="D" Style="{StaticResource SelectedCategorySegmentLabel}" />
                                    </Border>
                                    <Border x:Name="MonthlyRangeButton" Grid.Column="1" Style="{StaticResource CategorySegmentTab}" Padding="8,6" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="Monthly" /></Border.GestureRecognizers>
                                        <Label x:Name="MonthlyRangeLabel" Text="M" Style="{StaticResource CategorySegmentLabel}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <GraphicsView
                            x:Name="DetailChart"
                            HeightRequest="{OnIdiom Phone=220, Tablet=250, Desktop=250}"
                            MinimumWidthRequest="280"
                            InputTransparent="True"
                            SemanticProperties.Description="Transaction totals over time" />
                    </VerticalStackLayout>
                </Border>

                <Grid Margin="2,0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="TRANSACTIONS" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="Tap a transaction to edit" Style="{StaticResource BodyMuted}" FontSize="11" VerticalTextAlignment="Center" />
                </Grid>

                <Border Style="{StaticResource SoftCard}" Padding="24" IsVisible="{Binding HasNoTransactions}">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="No matching transactions" Style="{StaticResource CardTitle}" FontSize="16" HorizontalTextAlignment="Center" />
                        <Label Text="There are no transactions for this item in the selected month." Style="{StaticResource BodyMuted}" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="19" IsVisible="{Binding HasTransactions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionActivityGroup">
                            <VerticalStackLayout Spacing="10">
                                <Grid Margin="14,0" ColumnDefinitions="16,Auto,*,Auto" ColumnSpacing="9">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnActivityGroupHeaderTapped" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Path WidthRequest="13" HeightRequest="13" Data="M 6,4 L 14,12 L 6,20" Rotation="{Binding ChevronRotation}" Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource SectionLabel}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                                    <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" VerticalOptions="Center" />
                                    <Border Grid.Column="3" Padding="10,5" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 999">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsNetExpense}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BlushLight}, Dark={StaticResource BlushDark}}" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsNetIncome}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MintLight}, Dark={StaticResource MintDark}}" /></DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding DailyTotalText}" FontFamily="OpenSansSemibold" FontSize="11" HorizontalTextAlignment="End" VerticalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsNetExpense}" Value="True"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" /></DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsNetIncome}" Value="True"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" /></DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>
                                <Grid IsVisible="{Binding IsExpanded}" Margin="0,0,0,6">
                                    <Border Style="{StaticResource CardShadowLayer}" />
                                    <Border Style="{StaticResource CardSurface}" Padding="0">
                                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:TransactionActivityItem">
                                                    <views:TransactionActivityRow
                                                        HeightRequest="{Binding DescriptionRowHeightRequest}"
                                                        MinimumHeightRequest="63"
                                                        EnableSingleTapEdit="True"
                                                        EditRequested="OnTransactionEditRequested" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
