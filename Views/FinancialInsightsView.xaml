<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.FinancialInsightsView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FinancialTracker.Models">

    <VerticalStackLayout
        Spacing="13"
        BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:FinancialInsightItem">
                <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                    <Border
                        WidthRequest="5"
                        BackgroundColor="{DynamicResource Accent}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        VerticalOptions="Fill" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label
                            Text="{Binding Title}"
                            Style="{StaticResource CardTitle}"
                            FontSize="13" />
                        <Label
                            Text="{Binding Message}"
                            Style="{StaticResource BodyMuted}"
                            FontSize="12"
                            LineHeight="1.2" />
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
