<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24,30,24,126" Spacing="27">
            <VerticalStackLayout Spacing="5">
                <Label Text="Settings" Style="{StaticResource PageTitle}" />
                <Label Text="Make Financial Tracker feel like yours." Style="{StaticResource BodyMuted}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="13">
                <Label Text="PROFILE" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="17">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">
                                <Label
                                    Text="{Binding ProfileInitial, Mode=OneWay}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="21"
                                    TextColor="{DynamicResource AccentForeground}"
                                    MaxLines="1"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding GreetingName}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding SelectedCurrencySummary}" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                        <VerticalStackLayout Spacing="7">
                            <Label Text="NAME" Style="{StaticResource SectionLabel}" FontSize="10" />
                            <Border
                                Padding="13,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">
                                <Entry
                                    x:Name="NameEntry"
                                    Text="{Binding Name, Mode=TwoWay}"
                                    Placeholder="Your name"
                                    ReturnType="Done"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button
                            Text="{Binding SaveButtonText}"
                            IsEnabled="{Binding IsNameDirty}"
                            Clicked="OnSaveProfileClicked"
                            Pressed="OnButtonPressed"
                            Released="OnButtonReleased"
                            HeightRequest="49"
                            BackgroundColor="{DynamicResource Accent}"
                            TextColor="{DynamicResource AccentForeground}"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            BorderWidth="0"
                            CornerRadius="17">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Property="Button.BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
                                                <Setter Property="Button.TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="13">
                <Label Text="CURRENCY" Style="{StaticResource SectionLabel}" />
                <Label
                    Text="Choose how amounts are displayed throughout the app."
                    Style="{StaticResource BodyMuted}"
                    FontSize="12" />

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCurrencySelectorTapped" />
                            </Grid.GestureRecognizers>
                            <Image Source="{Binding SelectedCurrency.FlagAsset}" WidthRequest="38" HeightRequest="25" Aspect="AspectFit" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SelectedCurrencySummary}" Style="{StaticResource CardTitle}" FontSize="14" />
                                <Label Text="{Binding SelectedCurrencySymbol}" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label
                                x:Name="CurrencyChevron"
                                Grid.Column="2"
                                Text="⌄"
                                FontFamily="OpenSansSemibold"
                                FontSize="23"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="CurrencyOptionsPanel" IsVisible="False" Spacing="9">
                            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                <Border x:Name="MyrOption" Style="{StaticResource SelectedOptionCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCurrencyTapped" CommandParameter="MYR" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                        <Image Source="flag_myr.png" WidthRequest="34" HeightRequest="23" Aspect="AspectFit" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="MYR - Malaysian Ringgit" Style="{StaticResource CardTitle}" FontSize="14" />
                            <Label Text="Shown as RM" Style="{StaticResource BodyMuted}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label x:Name="MyrCheck" Grid.Column="2" Text="✓" FontFamily="OpenSansSemibold" FontSize="19" TextColor="{DynamicResource Accent}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="UsdOption" Style="{StaticResource OptionCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCurrencyTapped" CommandParameter="USD" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                        <Image Source="flag_usd.png" WidthRequest="34" HeightRequest="23" Aspect="AspectFit" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="USD - United States Dollar" Style="{StaticResource CardTitle}" FontSize="14" />
                            <Label Text="Shown as $" Style="{StaticResource BodyMuted}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label x:Name="UsdCheck" Grid.Column="2" Text="✓" IsVisible="False" FontFamily="OpenSansSemibold" FontSize="19" TextColor="{DynamicResource Accent}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="SgdOption" Style="{StaticResource OptionCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCurrencyTapped" CommandParameter="SGD" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                        <Image Source="flag_sgd.png" WidthRequest="34" HeightRequest="23" Aspect="AspectFit" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="SGD - Singapore Dollar" Style="{StaticResource CardTitle}" FontSize="14" />
                            <Label Text="Shown as S$" Style="{StaticResource BodyMuted}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label x:Name="SgdCheck" Grid.Column="2" Text="✓" IsVisible="False" FontFamily="OpenSansSemibold" FontSize="19" TextColor="{DynamicResource Accent}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border x:Name="KrwOption" Style="{StaticResource OptionCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCurrencyTapped" CommandParameter="KRW" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                        <Image Source="flag_krw.png" WidthRequest="34" HeightRequest="23" Aspect="AspectFit" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="KRW - South Korean Won" Style="{StaticResource CardTitle}" FontSize="14" />
                            <Label Text="Shown as ₩" Style="{StaticResource BodyMuted}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label x:Name="KrwCheck" Grid.Column="2" Text="✓" IsVisible="False" FontFamily="OpenSansSemibold" FontSize="19" TextColor="{DynamicResource Accent}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="13">
                <Label Text="DATA" Style="{StaticResource SectionLabel}" />
                <Label
                    Text="Manage the lists used when recording transactions."
                    Style="{StaticResource BodyMuted}"
                    FontSize="12" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoriesTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                                <Image
                                    Source="settings_categories.png"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Categories" Style="{StaticResource CardTitle}" FontSize="15" />
                                <Label Text="Expense and income categories" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="27" VerticalOptions="Center" />
                        </Grid>

                        <BoxView Margin="76,0,18,0" HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPaymentMethodsTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                                <Image
                                    Source="settings_payment_methods.png"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Payment methods" Style="{StaticResource CardTitle}" FontSize="15" />
                                <Label Text="Cash, cards and bank accounts" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="27" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="13">
                <Label Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Theme" Style="{StaticResource CardTitle}" FontSize="16" />
                                <Label Text="Changes apply immediately" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                Text="{Binding SelectedTheme}"
                                FontFamily="OpenSansSemibold"
                                TextColor="{DynamicResource Accent}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border x:Name="SystemThemeOption" Style="{StaticResource OptionCard}" Padding="10,9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="System" />
                                </Border.GestureRecognizers>
                                <Label Text="System" HorizontalTextAlignment="Center" />
                            </Border>
                            <Border x:Name="LightThemeOption" Grid.Column="1" Style="{StaticResource SelectedOptionCard}" Padding="10,9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="Light" />
                                </Border.GestureRecognizers>
                                <Label Text="Light" HorizontalTextAlignment="Center" />
                            </Border>
                            <Border x:Name="DarkThemeOption" Grid.Column="2" Style="{StaticResource OptionCard}" Padding="10,9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="Dark" />
                                </Border.GestureRecognizers>
                                <Label Text="Dark" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Accent colour" Style="{StaticResource CardTitle}" FontSize="16" />
                                <Label Text="Changes buttons and highlighted controls" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="1"
                                Text="{Binding SelectedAccentLabel}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                TextColor="{DynamicResource Accent}"
                                VerticalOptions="Center" />
                        </Grid>

                        <HorizontalStackLayout Spacing="8">
                            <Border x:Name="PurpleAccentOption" Style="{StaticResource SelectedOptionCard}" WidthRequest="44" HeightRequest="44" Padding="6">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccentTapped" CommandParameter="#5044E4" /></Border.GestureRecognizers>
                                <Border BackgroundColor="#5044E4" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label x:Name="PurpleAccentCheck" Text="✓" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Border>
                            <Border x:Name="OceanAccentOption" Style="{StaticResource OptionCard}" WidthRequest="44" HeightRequest="44" Padding="6">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccentTapped" CommandParameter="#1477D4" /></Border.GestureRecognizers>
                                <Border BackgroundColor="#1477D4" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label x:Name="OceanAccentCheck" Text="✓" TextColor="White" IsVisible="False" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Border>
                            <Border x:Name="TealAccentOption" Style="{StaticResource OptionCard}" WidthRequest="44" HeightRequest="44" Padding="6">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccentTapped" CommandParameter="#0F766E" /></Border.GestureRecognizers>
                                <Border BackgroundColor="#0F766E" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label x:Name="TealAccentCheck" Text="✓" TextColor="White" IsVisible="False" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Border>
                            <Border x:Name="RoseAccentOption" Style="{StaticResource OptionCard}" WidthRequest="44" HeightRequest="44" Padding="6">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccentTapped" CommandParameter="#C2416C" /></Border.GestureRecognizers>
                                <Border BackgroundColor="#C2416C" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label x:Name="RoseAccentCheck" Text="✓" TextColor="White" IsVisible="False" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Border>
                            <Border x:Name="OrangeAccentOption" Style="{StaticResource OptionCard}" WidthRequest="44" HeightRequest="44" Padding="6">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccentTapped" CommandParameter="#C65D16" /></Border.GestureRecognizers>
                                <Border BackgroundColor="#C65D16" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label x:Name="OrangeAccentCheck" Text="✓" TextColor="White" IsVisible="False" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Border>
                            <Border x:Name="SlateAccentOption" Style="{StaticResource OptionCard}" WidthRequest="44" HeightRequest="44" Padding="6">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccentTapped" CommandParameter="#475569" /></Border.GestureRecognizers>
                                <Border BackgroundColor="#475569" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label x:Name="SlateAccentCheck" Text="✓" TextColor="White" IsVisible="False" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </Border>
                        </HorizontalStackLayout>

                        <Border Style="{StaticResource SoftCard}" Padding="13">
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="14">
                                <GraphicsView
                                    x:Name="AccentColorWheel"
                                    WidthRequest="150"
                                    HeightRequest="150"
                                    HorizontalOptions="Start"
                                    StartInteraction="OnAccentWheelInteraction"
                                    DragInteraction="OnAccentWheelInteraction" />
                                <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                    <Label Text="Colour wheel" Style="{StaticResource CardTitle}" FontSize="14" />
                                    <Label Text="Drag anywhere on the wheel, then apply the colour below." Style="{StaticResource BodyMuted}" FontSize="11" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Border
                                            x:Name="WheelColorPreview"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="#5044E4"
                                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                            StrokeThickness="1.5"
                                            StrokeShape="RoundRectangle 17" />
                                        <Label
                                            x:Name="WheelColorHexLabel"
                                            Grid.Column="1"
                                            Text="#5044E4"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="Brightness" Style="{StaticResource SectionLabel}" FontSize="10" />
                                    <Slider
                                        x:Name="AccentBrightnessSlider"
                                        Minimum="0"
                                        Maximum="1"
                                        MinimumTrackColor="{DynamicResource Accent}"
                                        ThumbColor="{DynamicResource Accent}"
                                        ValueChanged="OnAccentBrightnessChanged" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                            <Border
                                Padding="13,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">
                                <Entry
                                    x:Name="AccentHexEntry"
                                    Text="{Binding CustomAccentColorHex, Mode=TwoWay}"
                                    Placeholder="#5044E4"
                                    MaxLength="7"
                                    ReturnType="Done"
                                    Completed="OnApplyCustomAccent"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            </Border>
                            <Button
                                Grid.Column="1"
                                Text="{Binding ApplyAccentButtonText}"
                                IsEnabled="{Binding CanApplyCustomAccent}"
                                Clicked="OnApplyCustomAccent"
                                Pressed="OnButtonPressed"
                                Released="OnButtonReleased"
                                Padding="20,0"
                                BackgroundColor="{DynamicResource Accent}"
                                TextColor="{DynamicResource AccentForeground}"
                                FontFamily="OpenSansSemibold"
                                CornerRadius="14">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="Button.BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
                                                    <Setter Property="Button.TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </Grid>
                        <Label
                            Text="{Binding AccentValidationMessage}"
                            IsVisible="{Binding HasAccentValidationError}"
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                <Label
                    Text="Financial Tracker"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="{Binding AppVersionText}" Style="{StaticResource BodyMuted}" FontSize="11" />
                    <Label Text="·" Style="{StaticResource BodyMuted}" FontSize="11" />
                    <Label Text="{Binding BuildRevisionText}" Style="{StaticResource BodyMuted}" FontSize="11" />
                </HorizontalStackLayout>
                <Label
                    Margin="0,5,0,0"
                    Text="Your settings stay on this device."
                    Style="{StaticResource BodyMuted}"
                    FontSize="11"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

        <Grid
            x:Name="DataDrawerOverlay"
            ZIndex="20"
            IsVisible="False"
            Opacity="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <Border
                x:Name="DataDrawerCard"
                Margin="0"
                Padding="24,30,24,24"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                StrokeThickness="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="44,*,44" ColumnSpacing="14">
                        <Label
                            x:Name="DataDrawerTitle"
                            Grid.Column="1"
                            Text="Categories"
                            Style="{StaticResource CardTitle}"
                            FontSize="21"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                        <Border
                            Grid.Column="2"
                            WidthRequest="42"
                            HeightRequest="42"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 21">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDataDrawerCloseTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="&#x2190;"
                                FontSize="22"
                                TextColor="{DynamicResource Accent}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <ScrollView
                        Grid.Row="1"
                        Margin="0,27,0,0"
                        VerticalScrollBarVisibility="Never">
                    <Grid Padding="0,0,0,24">
                    <VerticalStackLayout x:Name="CategoriesDrawerContent" Spacing="25">
                        <Border
                            WidthRequest="204"
                            HeightRequest="46"
                            Padding="3"
                            HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark=#3A3A3D}"
                            Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark=#48484C}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14">
                            <Grid ColumnDefinitions="*,*">
                                <Border x:Name="ExpenseCategoryTab" Style="{StaticResource SelectedCategorySegmentTab}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTypeTapped" CommandParameter="Expense" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ExpenseCategoryLabel" Text="Expense" Style="{StaticResource SelectedCategorySegmentLabel}" />
                                </Border>
                                <Border x:Name="IncomeCategoryTab" Grid.Column="1" Style="{StaticResource CategorySegmentTab}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTypeTapped" CommandParameter="Income" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="IncomeCategoryLabel" Text="Income" Style="{StaticResource CategorySegmentLabel}" />
                                </Border>
                            </Grid>
                        </Border>

                        <VerticalStackLayout x:Name="ExpenseCategoriesPanel" Spacing="12">
                            <Label Text="11 EXPENSE CATEGORIES" Style="{StaticResource SectionLabel}" FontSize="10" />
                            <Border Style="{StaticResource SoftCard}" Padding="12,10">
                                <Grid ColumnDefinitions="58,*" ColumnSpacing="15">
                                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 17">
                                        <Image Source="category_beauty.png" WidthRequest="56" HeightRequest="56" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="Beauty" Style="{StaticResource CardTitle}" FontSize="16" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SoftCard}" Padding="12,10">
                                <Grid ColumnDefinitions="58,*" ColumnSpacing="15">
                                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 17">
                                        <Image Source="category_bills_utilities.png" WidthRequest="56" HeightRequest="56" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="Bills &amp; Utilities" Style="{StaticResource CardTitle}" FontSize="16" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SoftCard}" Padding="12,10">
                                <Grid ColumnDefinitions="58,*" ColumnSpacing="15">
                                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 17">
