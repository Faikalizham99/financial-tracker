<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.Skeletons.TransactionStatisticsLoadingSkeletonView"
    x:Name="SkeletonRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FinancialTracker.Controls"
    HorizontalOptions="Fill"
    SizeChanged="OnSkeletonRootSizeChanged">

    <ScrollView HorizontalOptions="Fill" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            x:Name="SkeletonContent"
            Padding="{OnIdiom Phone='18,22,18,38', Tablet='24,28,24,44', Desktop='24,28,24,44'}"
            Spacing="18"
            MaximumWidthRequest="940"
            HorizontalOptions="Center">
            <Grid ColumnDefinitions="44,*,110" ColumnSpacing="12">
                <controls:SkeletonBlock WidthRequest="44" HeightRequest="44" />
                <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                    <controls:SkeletonBlock WidthRequest="145" HeightRequest="20" HorizontalOptions="Start" />
                    <controls:SkeletonBlock WidthRequest="175" HeightRequest="9" HorizontalOptions="Start" />
                </VerticalStackLayout>
                <controls:SkeletonBlock Grid.Column="2" WidthRequest="110" HeightRequest="34" />
            </Grid>

            <controls:SkeletonBlock HeightRequest="48" SkeletonRadius="15" />

            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <controls:SkeletonBlock WidthRequest="85" HeightRequest="10" HorizontalOptions="Start" />
                    <controls:SkeletonBlock WidthRequest="245" HeightRequest="34" HorizontalOptions="Start" />
                    <controls:SkeletonBlock WidthRequest="280" HeightRequest="10" HorizontalOptions="Start" />
                    <controls:SkeletonBlock HeightRequest="190" SkeletonRadius="12" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SoftCard}" Padding="18">
                <VerticalStackLayout Spacing="17">
                    <controls:SkeletonBlock HeightRequest="58" SkeletonRadius="12" />
                    <controls:SkeletonBlock HeightRequest="1" SkeletonRadius="0" />
                    <controls:SkeletonBlock HeightRequest="58" SkeletonRadius="12" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="13">
                    <controls:SkeletonBlock WidthRequest="210" HeightRequest="11" HorizontalOptions="Start" />
                    <controls:SkeletonBlock HeightRequest="42" SkeletonRadius="14" />
                    <controls:SkeletonBlock HeightRequest="66" SkeletonRadius="13" />
                    <controls:SkeletonBlock HeightRequest="66" SkeletonRadius="13" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
