<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.Skeletons.TransactionsLoadingSkeletonView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FinancialTracker.Controls">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="22,28,22,126" Spacing="21">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,44,44" RowSpacing="6" ColumnSpacing="9">
                <controls:SkeletonBlock Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}" WidthRequest="190" HeightRequest="31" HorizontalOptions="Start" />
                <controls:SkeletonBlock
                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                    Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                    WidthRequest="150"
                    HeightRequest="20"
                    HorizontalOptions="End" />
                <controls:SkeletonBlock Grid.Column="2" WidthRequest="44" HeightRequest="44" />
                <controls:SkeletonBlock Grid.Column="3" WidthRequest="44" HeightRequest="44" />
            </Grid>

            <Border Style="{StaticResource Card}" HeightRequest="268">
                <VerticalStackLayout Spacing="17">
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:SkeletonBlock WidthRequest="178" HeightRequest="15" HorizontalOptions="Start" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="9">
                            <controls:SkeletonBlock WidthRequest="32" HeightRequest="12" />
                            <controls:SkeletonBlock WidthRequest="45" HeightRequest="25" />
                            <controls:SkeletonBlock WidthRequest="26" HeightRequest="26" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:SkeletonBlock WidthRequest="245" HeightRequest="40" HorizontalOptions="Start" />
                        <controls:SkeletonBlock Grid.Column="1" WidthRequest="42" HeightRequest="32" VerticalOptions="Center" />
                    </Grid>
                    <controls:SkeletonBlock WidthRequest="205" HeightRequest="13" HorizontalOptions="Start" />
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                    <Grid ColumnDefinitions="*,1,*" ColumnSpacing="18">
                        <controls:SkeletonBlock HeightRequest="48" />
                        <BoxView Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                        <controls:SkeletonBlock Grid.Column="2" HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="9">
                <controls:SkeletonBlock WidthRequest="70" HeightRequest="10" HorizontalOptions="Start" />
                <Border Style="{StaticResource SoftCard}" Padding="14,10">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="40,*,18" ColumnSpacing="11">
                            <controls:SkeletonBlock WidthRequest="40" HeightRequest="40" SkeletonRadius="12" />
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <controls:SkeletonBlock WidthRequest="98" HeightRequest="8" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="165" HeightRequest="12" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <controls:SkeletonBlock Grid.Column="2" WidthRequest="14" HeightRequest="20" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                        <Grid ColumnDefinitions="40,*,18" ColumnSpacing="11">
                            <controls:SkeletonBlock WidthRequest="40" HeightRequest="40" SkeletonRadius="12" />
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <controls:SkeletonBlock WidthRequest="72" HeightRequest="8" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="138" HeightRequest="12" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <controls:SkeletonBlock Grid.Column="2" WidthRequest="14" HeightRequest="20" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="11">
                <Grid Margin="14,0" ColumnDefinitions="18,95,*,76" ColumnSpacing="9">
                    <controls:SkeletonBlock WidthRequest="13" HeightRequest="13" />
                    <controls:SkeletonBlock Grid.Column="1" WidthRequest="90" HeightRequest="10" />
                    <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" VerticalOptions="Center" />
                    <controls:SkeletonBlock Grid.Column="3" WidthRequest="70" HeightRequest="25" />
                </Grid>
                <Border Style="{StaticResource SoftCard}" Padding="14,7">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="0,8" ColumnDefinitions="82,*,76" ColumnSpacing="12">
                            <Grid ColumnDefinitions="38,8,38">
                                <controls:SkeletonBlock WidthRequest="38" HeightRequest="38" SkeletonRadius="12" />
                                <controls:SkeletonBlock Grid.Column="2" WidthRequest="38" HeightRequest="38" SkeletonRadius="12" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                <controls:SkeletonBlock WidthRequest="155" HeightRequest="12" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="110" HeightRequest="9" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <controls:SkeletonBlock Grid.Column="2" WidthRequest="70" HeightRequest="12" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                        <Grid Padding="0,8" ColumnDefinitions="82,*,76" ColumnSpacing="12">
                            <Grid ColumnDefinitions="38,8,38">
                                <controls:SkeletonBlock WidthRequest="38" HeightRequest="38" SkeletonRadius="12" />
                                <controls:SkeletonBlock Grid.Column="2" WidthRequest="38" HeightRequest="38" SkeletonRadius="12" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                <controls:SkeletonBlock WidthRequest="125" HeightRequest="12" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="92" HeightRequest="9" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <controls:SkeletonBlock Grid.Column="2" WidthRequest="62" HeightRequest="12" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
