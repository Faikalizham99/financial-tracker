<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.ExpensesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FinancialTracker.Models"
    xmlns:views="clr-namespace:FinancialTracker.Views">

    <Grid>
    <ScrollView x:Name="TransactionsScrollView" Scrolled="OnTransactionsScrolled" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="22,28,22,126" Spacing="21">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="9">
                <Label
                    Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                    Text="Transactions"
                    Style="{StaticResource PageTitle}"
                    FontSize="{OnIdiom Phone=29, Tablet=38, Desktop=38}"
                    FontAutoScalingEnabled="False"
                    LineBreakMode="NoWrap"
                    MaxLines="1"
                    VerticalTextAlignment="Center" />

                <HorizontalStackLayout
                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                    Grid.ColumnSpan="{OnIdiom Phone=4, Tablet=1, Desktop=1}"
                    Spacing="2"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <Border WidthRequest="30" HeightRequest="30" Padding="6" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPreviousMonthTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M 15,4 L 7,12 L 15,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="MonthSwitcherLabel" Text="September 2026" FontFamily="OpenSansSemibold" FontSize="13" MinimumWidthRequest="110" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Border WidthRequest="30" HeightRequest="30" Padding="6" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNextMonthTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <Border
                    x:Name="CalendarFilterButton"
                    Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 22"
                    SemanticProperties.Description="Filter transactions by date range">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarFilterTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Path
                            x:Name="CalendarFilterIcon"
                            WidthRequest="21"
                            HeightRequest="21"
                            Data="M 5,5 L 19,5 Q 21,5 21,7 L 21,19 Q 21,21 19,21 L 5,21 Q 3,21 3,19 L 3,7 Q 3,5 5,5 Z M 3,10 L 21,10 M 8,3 L 8,7 M 16,3 L 16,7 M 7,14 L 9,14 M 12,14 L 14,14 M 17,14 L 19,14 M 7,18 L 9,18 M 12,18 L 14,18"
                            Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                            StrokeThickness="1.8"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            Fill="Transparent"
                            Aspect="Uniform"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Border
                            x:Name="CalendarFilterActiveDot"
                            WidthRequest="9"
                            HeightRequest="9"
                            Margin="0,5,5,0"
                            IsVisible="False"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            BackgroundColor="{DynamicResource Accent}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 5" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" WidthRequest="44" HeightRequest="44" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 22">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped" />
                    </Border.GestureRecognizers>
                    <Path WidthRequest="21" HeightRequest="21" Data="M 10,3 A 7,7 0 1 0 10,17 A 7,7 0 1 0 10,3 M 15,15 L 21,21" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2" StrokeLineCap="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <views:MonthlySummaryCard x:Name="TransactionsMonthlySummary" ShowTransactionCount="True" />

            <VerticalStackLayout Spacing="9">
                <Grid Margin="2,0" ColumnDefinitions="*,Auto">
                    <Label Text="FILTERS" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                    <Border
                        x:Name="ClearAllFiltersButton"
                        Grid.Column="1"
                        Padding="10,5"
                        IsVisible="False"
                        BackgroundColor="{DynamicResource AccentTint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAllFilterTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Clear all" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{DynamicResource Accent}" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource SoftCard}" Padding="0">
                    <Grid RowDefinitions="Auto,1,Auto">
                        <Grid
                            x:Name="PaymentFilterRow"
                            Padding="14,11"
                            ColumnDefinitions="40,*,18"
                            ColumnSpacing="11">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPaymentFilterTapped" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <Image x:Name="PaymentFilterIcon" Source="settings_payment_methods.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="PAYMENT METHOD" Style="{StaticResource SectionLabel}" FontSize="9" CharacterSpacing="0.8" />
                                <Label x:Name="PaymentFilterValueLabel" Text="Any payment method" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <Path Grid.Column="2" WidthRequest="16" HeightRequest="16" Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" VerticalOptions="Center" />
                        </Grid>

                        <BoxView Grid.Row="1" Margin="14,0" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                        <Grid
                            x:Name="CategoryFilterRow"
                            Grid.Row="2"
                            Padding="14,11"
                            ColumnDefinitions="40,*,18"
                            ColumnSpacing="11">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryFilterTapped" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                <Image x:Name="CategoryFilterIcon" Source="settings_categories.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="CATEGORY" Style="{StaticResource SectionLabel}" FontSize="9" CharacterSpacing="0.8" />
                                <Label x:Name="CategoryFilterValueLabel" Text="Any category" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <Path Grid.Column="2" WidthRequest="16" HeightRequest="16" Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Border x:Name="EmptyActivityState" Style="{StaticResource SoftCard}" Padding="24" IsVisible="True">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label x:Name="EmptyActivityTitle" Text="No transactions this month" Style="{StaticResource CardTitle}" FontSize="16" HorizontalTextAlignment="Center" />
                    <Label Text="Use the bottom + button to record one." Style="{StaticResource BodyMuted}" FontSize="12" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="ActivityGroupsLayout" Spacing="19" IsVisible="False" SizeChanged="OnActivityGroupsLayoutSizeChanged">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionActivityGroup">
                        <VerticalStackLayout ClassId="TransactionActivityGroup" Spacing="10">
                            <Grid Margin="14,0" ColumnDefinitions="16,Auto,*,Auto" ColumnSpacing="9">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnActivityGroupHeaderTapped" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Path
                                    WidthRequest="13"
                                    HeightRequest="13"
                                    Data="M 6,4 L 14,12 L 6,20"
                                    Rotation="{Binding ChevronRotation}"
                                    Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                    StrokeThickness="2.2"
                                    StrokeLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Fill="Transparent"
                                    Aspect="Uniform"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Title}"
                                    Style="{StaticResource SectionLabel}"
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    VerticalTextAlignment="Center" />
                                <BoxView
                                    Grid.Column="2"
                                    HeightRequest="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                    VerticalOptions="Center" />
                                <Border
                                    Grid.Column="3"
                                    Padding="10,5"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsNetExpense}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BlushLight}, Dark={StaticResource BlushDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsNetIncome}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MintLight}, Dark={StaticResource MintDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding DailyTotalText}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalTextAlignment="End" VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsNetExpense}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsNetIncome}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                            <Grid ClassId="TransactionActivityGroupBody" Margin="0,0,0,6" IsVisible="{Binding IsExpanded}">
                                <Border Style="{StaticResource CardShadowLayer}" />
                                <Border Style="{StaticResource CardSurface}" Padding="0">
                                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransactionActivityItem">
                                            <SwipeView>
                                                <SwipeView.RightItems>
                                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                                        <SwipeItemView Invoked="OnEditTransactionInvoked">
                                                            <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{DynamicResource Accent}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                                <Path WidthRequest="22" HeightRequest="22" Data="M 4,20 L 8,19 L 19,8 L 16,5 L 5,16 Z M 14,7 L 17,10" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                                <Label Text="Edit" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{DynamicResource AccentForeground}" HorizontalTextAlignment="Center" />
                                                            </VerticalStackLayout>
                                                        </SwipeItemView>
                                                        <SwipeItemView Invoked="OnDeleteTransactionInvoked">
                                                            <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                                <Path WidthRequest="22" HeightRequest="22" Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 7,7 L 8,20 L 16,20 L 17,7 M 10,11 L 10,17 M 14,11 L 14,17" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                                <Label Text="Delete" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                                                            </VerticalStackLayout>
                                                        </SwipeItemView>
                                                    </SwipeItems>
                                                </SwipeView.RightItems>
                                                <Grid RowDefinitions="Auto,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" HandlerChanged="OnTransactionRowHandlerChanged">
                                                    <BoxView
                                                        Grid.RowSpan="2"
                                                        ClassId="TransactionSearchHighlight"
                                                        BackgroundColor="{DynamicResource AccentTint}"
                                                        Opacity="0"
                                                        InputTransparent="True" />
                                                    <Grid ZIndex="1" Padding="14,12" ColumnDefinitions="90,*,Auto" ColumnSpacing="12">
                                                        <Grid ColumnDefinitions="38,14,38">
                                                            <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                                <Image Source="{Binding IconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                            </Border>
                                                            <Label Grid.Column="1" Text="×" Style="{StaticResource BodyMuted}" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                            <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                                <Image Source="{Binding PaymentMethodIconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                            </Border>
                                                        </Grid>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                            <Grid
                                                                HeightRequest="{Binding DescriptionHeaderHeightRequest}"
                                                                MinimumHeightRequest="20"
                                                                ColumnDefinitions="*,Auto"
                                                                ColumnSpacing="6">
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnTransactionDescriptionTapped" CommandParameter="{Binding .}" />
                                                                </Grid.GestureRecognizers>
                                                                <Label
                                                                    ClassId="ExpandableTransactionDescription"
                                                                    Text="{Binding Description}"
                                                                    Style="{StaticResource CardTitle}"
                                                                    FontSize="14"
                                                                    LineBreakMode="{Binding DescriptionLineBreakMode}"
                                                                    MaxLines="{Binding DescriptionMaxLines}"
                                                                    SizeChanged="OnTransactionDescriptionSizeChanged" />
                                                                <Border
                                                                    Grid.Column="1"
                                                                    WidthRequest="20"
                                                                    HeightRequest="20"
                                                                    IsVisible="{Binding CanExpandDescription}"
                                                                    BackgroundColor="{DynamicResource AccentTint}"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 10"
                                                                    VerticalOptions="Start"
                                                                    SemanticProperties.Description="Expand or collapse description">
                                                                    <Path
                                                                        WidthRequest="10"
                                                                        HeightRequest="10"
                                                                        Data="M 4,6 L 8,10 L 12,6"
                                                                        Rotation="{Binding DescriptionIndicatorRotation}"
                                                                        Stroke="{DynamicResource Accent}"
                                                                        StrokeThickness="2"
                                                                        StrokeLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        Fill="Transparent"
                                                                        Aspect="Uniform"
                                                                        HorizontalOptions="Center"
                                                                        VerticalOptions="Center" />
                                                                </Border>
                                                            </Grid>
                                                            <Label Text="{Binding DetailText}" Style="{StaticResource BodyMuted}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2" Text="{Binding AmountText}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalTextAlignment="End" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Grid>
                                                    <BoxView Grid.Row="1" ZIndex="1" Margin="14,0" HeightRequest="1" IsVisible="{Binding ShowDivider}" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                                </Grid>
                                            </SwipeView>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <Border
        x:Name="StickyActivityHeader"
        Margin="22,8,22,0"
        Padding="12,8"
        IsVisible="False"
        ZIndex="10"
        HorizontalOptions="Fill"
        VerticalOptions="Start"
        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
        Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,4" Opacity="0.14" Radius="12" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnActivityGroupHeaderTapped" CommandParameter="{Binding .}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="16,Auto,*,Auto" ColumnSpacing="9">
            <Path
                WidthRequest="13"
                HeightRequest="13"
                Data="M 6,4 L 14,12 L 6,20"
                Rotation="{Binding ChevronRotation}"
                Stroke="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                StrokeThickness="2.2"
                StrokeLineCap="Round"
                StrokeLineJoin="Round"
                Fill="Transparent"
                Aspect="Uniform"
                VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource SectionLabel}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
            <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" VerticalOptions="Center" />
            <Border Grid.Column="3" Padding="10,5" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 999">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsNetExpense}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BlushLight}, Dark={StaticResource BlushDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsNetIncome}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MintLight}, Dark={StaticResource MintDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding DailyTotalText}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalTextAlignment="End" VerticalTextAlignment="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsNetExpense}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsNetIncome}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>
    </Border>

    <Grid x:Name="FilterSelectorOverlay" IsVisible="False" Opacity="0" ZIndex="40" SizeChanged="OnFilterSelectorOverlaySizeChanged">
        <BoxView BackgroundColor="#99000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFilterSelectorBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            x:Name="FilterSelectorCard"
            Padding="18,18,18,20"
            WidthRequest="500"
            HeightRequest="520"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.8" Radius="0" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,*" RowSpacing="15">
                <Grid ColumnDefinitions="*,42">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label x:Name="FilterSelectorTitle" Text="Choose a filter" Style="{StaticResource CardTitle}" FontSize="20" />
                        <Label Text="Tap an option to apply it" Style="{StaticResource BodyMuted}" FontSize="12" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" Style="{StaticResource Pill}" Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterSelectorCloseTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="×" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <CollectionView
                    x:Name="FilterSelectorCollection"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="OnFilterSelectorSelectionChanged"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="9" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SelectableTransactionOption">
                            <Border Style="{StaticResource SoftCard}" Padding="10,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentTint}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="48,*,30" ColumnSpacing="13">
                                    <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                        <Image Source="{Binding IconAsset}" WidthRequest="46" HeightRequest="46" Aspect="AspectFill" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                                    <Border Grid.Column="2" WidthRequest="28" HeightRequest="28" IsVisible="{Binding IsSelected}" BackgroundColor="{DynamicResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                        <Path WidthRequest="15" HeightRequest="15" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>

    <Grid x:Name="DateRangeFilterOverlay" IsVisible="False" Opacity="0" ZIndex="45">
        <BoxView BackgroundColor="#99000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDateRangeBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            x:Name="DateRangeFilterCard"
            Margin="18"
            Padding="20"
            MaximumWidthRequest="440"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.8" Radius="0" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="*,42">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Filter by date" Style="{StaticResource CardTitle}" FontSize="20" />
                        <Label x:Name="DateRangeMonthLabel" Text="Choose a date range" Style="{StaticResource BodyMuted}" FontSize="12" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" Style="{StaticResource Pill}" Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDateRangeCloseTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="×" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource SoftCard}" Padding="14,11">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStartDateTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <Path WidthRequest="24" HeightRequest="24" Data="M 5,5 L 19,5 Q 21,5 21,7 L 21,19 Q 21,21 19,21 L 5,21 Q 3,21 3,19 L 3,7 Q 3,5 5,5 Z M 3,10 L 21,10 M 8,3 L 8,7 M 16,3 L 16,7" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="START DATE" Style="{StaticResource SectionLabel}" FontSize="9" />
                                <Label x:Name="StartDateLabel" Text="1 September 2026" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <DatePicker x:Name="StartDatePicker" Grid.ColumnSpan="2" Opacity="0.02" DateSelected="OnStartDateSelected" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SoftCard}" Padding="14,11">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEndDateTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <Path WidthRequest="24" HeightRequest="24" Data="M 5,5 L 19,5 Q 21,5 21,7 L 21,19 Q 21,21 19,21 L 5,21 Q 3,21 3,19 L 3,7 Q 3,5 5,5 Z M 3,10 L 21,10 M 8,3 L 8,7 M 16,3 L 16,7" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="END DATE" Style="{StaticResource SectionLabel}" FontSize="9" />
                                <Label x:Name="EndDateLabel" Text="30 September 2026" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <DatePicker x:Name="EndDatePicker" Grid.ColumnSpan="2" Opacity="0.02" DateSelected="OnEndDateSelected" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border HeightRequest="50" Style="{StaticResource Pill}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDateRangeClearTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Clear" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" HeightRequest="50" BackgroundColor="{DynamicResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 999">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDateRangeApplyTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Apply" FontFamily="OpenSansSemibold" TextColor="{DynamicResource AccentForeground}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>
</ContentView>
