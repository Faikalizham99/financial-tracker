<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.ExpensesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FinancialTracker.Models"
    xmlns:views="clr-namespace:FinancialTracker.Views">

    <Grid>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="22,28,22,126" Spacing="21">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                <Label Text="Transactions" Style="{StaticResource PageTitle}" FontSize="38" VerticalTextAlignment="Center" />

                <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="‹" FontFamily="OpenSansSemibold" FontSize="28" WidthRequest="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPreviousMonthTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="MonthSwitcherLabel" Text="September 2026" FontFamily="OpenSansSemibold" FontSize="13" MinimumWidthRequest="110" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Label Text="›" FontFamily="OpenSansSemibold" FontSize="28" WidthRequest="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNextMonthTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 22">
                    <Label Text="⌕" FontFamily="OpenSansSemibold" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <views:MonthlySummaryCard x:Name="TransactionsMonthlySummary" ShowTransactionCount="True" />

            <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="9">
                <Border x:Name="AllFilterChip" Padding="17,8" BackgroundColor="{DynamicResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAllFilterTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="AllFilterLabel" Text="All" FontFamily="OpenSansSemibold" TextColor="{DynamicResource AccentForeground}" />
                </Border>
                <Border x:Name="PaymentFilterChip" Grid.Column="1" Padding="10,7" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPaymentFilterTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="7">
                        <Border WidthRequest="28" HeightRequest="28" Padding="2" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 9">
                            <Image x:Name="PaymentFilterIcon" Source="settings_payment_methods.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFill" />
                        </Border>
                        <Label x:Name="PaymentFilterLabel" Grid.Column="1" Text="Payment method" Style="{StaticResource BodyMuted}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Border x:Name="CategoryFilterChip" Grid.Column="2" Padding="10,7" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryFilterTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="7">
                        <Border WidthRequest="28" HeightRequest="28" Padding="2" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 9">
                            <Image x:Name="CategoryFilterIcon" Source="settings_categories.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFill" />
                        </Border>
                        <Label x:Name="CategoryFilterLabel" Grid.Column="1" Text="Category" Style="{StaticResource BodyMuted}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="EmptyActivityState" Style="{StaticResource SoftCard}" Padding="24" IsVisible="True">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label x:Name="EmptyActivityTitle" Text="No transactions this month" Style="{StaticResource CardTitle}" FontSize="16" HorizontalTextAlignment="Center" />
                    <Label Text="Use the bottom + button to record one." Style="{StaticResource BodyMuted}" FontSize="12" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="ActivityGroupsLayout" Spacing="19" IsVisible="False">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionActivityGroup">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,0,0,6">
                                <Border Style="{StaticResource CardShadowLayer}" />
                                <Border Style="{StaticResource CardSurface}" Padding="0">
                                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransactionActivityItem">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Grid Padding="14,12" ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                                    <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                                        <Image Source="{Binding IconAsset}" WidthRequest="46" HeightRequest="46" Aspect="AspectFill" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Description}" Style="{StaticResource CardTitle}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                                                        <Label Text="{Binding DetailText}" Style="{StaticResource BodyMuted}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding AmountText}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalTextAlignment="End" VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Grid>
                                                <BoxView Grid.Row="1" Margin="74,0,14,0" HeightRequest="1" IsVisible="{Binding ShowDivider}" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <Grid x:Name="FilterSelectorOverlay" IsVisible="False" Opacity="0" ZIndex="40" SizeChanged="OnFilterSelectorOverlaySizeChanged">
        <BoxView BackgroundColor="#99000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFilterSelectorBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            x:Name="FilterSelectorCard"
            Padding="18,18,18,20"
            WidthRequest="500"
            HeightRequest="520"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.8" Radius="0" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,*" RowSpacing="15">
                <Grid ColumnDefinitions="*,42">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label x:Name="FilterSelectorTitle" Text="Choose a filter" Style="{StaticResource CardTitle}" FontSize="20" />
                        <Label Text="Tap an option to apply it" Style="{StaticResource BodyMuted}" FontSize="12" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" Style="{StaticResource Pill}" Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterSelectorCloseTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="×" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <CollectionView
                    x:Name="FilterSelectorCollection"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="OnFilterSelectorSelectionChanged"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionOption">
                            <Border Style="{StaticResource OptionCard}" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                        <Image Source="{Binding IconAsset}" WidthRequest="44" HeightRequest="44" Aspect="AspectFill" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ContentView>
