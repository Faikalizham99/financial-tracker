<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.ExpensesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FinancialTracker.Models"
    xmlns:views="clr-namespace:FinancialTracker.Views">

    <Grid>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="22,28,22,126" Spacing="21">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="6" ColumnSpacing="9">
                <Label
                    Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                    Text="Transactions"
                    Style="{StaticResource PageTitle}"
                    FontSize="{OnIdiom Phone=29, Tablet=38, Desktop=38}"
                    FontAutoScalingEnabled="False"
                    LineBreakMode="NoWrap"
                    MaxLines="1"
                    VerticalTextAlignment="Center" />

                <HorizontalStackLayout
                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                    Grid.ColumnSpan="{OnIdiom Phone=3, Tablet=1, Desktop=1}"
                    Spacing="2"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <Border WidthRequest="30" HeightRequest="30" Padding="6" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPreviousMonthTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M 15,4 L 7,12 L 15,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="MonthSwitcherLabel" Text="September 2026" FontFamily="OpenSansSemibold" FontSize="13" MinimumWidthRequest="110" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Border WidthRequest="30" HeightRequest="30" Padding="6" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNextMonthTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 22">
                    <Label Text="⌕" FontFamily="OpenSansSemibold" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <views:MonthlySummaryCard x:Name="TransactionsMonthlySummary" ShowTransactionCount="True" />

            <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="9">
                <Border x:Name="AllFilterChip" Padding="17,8" BackgroundColor="{DynamicResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAllFilterTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="AllFilterLabel" Text="All" FontFamily="OpenSansSemibold" TextColor="{DynamicResource AccentForeground}" />
                </Border>
                <Border x:Name="PaymentFilterChip" Grid.Column="1" Padding="10,7" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPaymentFilterTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="7">
                        <Border WidthRequest="28" HeightRequest="28" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                            <Image x:Name="PaymentFilterIcon" Source="settings_payment_methods.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFill" />
                        </Border>
                        <Label x:Name="PaymentFilterLabel" Grid.Column="1" Text="Payment method" Style="{StaticResource BodyMuted}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Border x:Name="CategoryFilterChip" Grid.Column="2" Padding="10,7" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryFilterTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="7">
                        <Border WidthRequest="28" HeightRequest="28" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                            <Image x:Name="CategoryFilterIcon" Source="settings_categories.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFill" />
                        </Border>
                        <Label x:Name="CategoryFilterLabel" Grid.Column="1" Text="Category" Style="{StaticResource BodyMuted}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="EmptyActivityState" Style="{StaticResource SoftCard}" Padding="24" IsVisible="True">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label x:Name="EmptyActivityTitle" Text="No transactions this month" Style="{StaticResource CardTitle}" FontSize="16" HorizontalTextAlignment="Center" />
                    <Label Text="Use the bottom + button to record one." Style="{StaticResource BodyMuted}" FontSize="12" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="ActivityGroupsLayout" Spacing="19" IsVisible="False">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionActivityGroup">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="{Binding DailyTotalText}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalTextAlignment="End" VerticalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsNetExpense}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsNetIncome}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Border Style="{StaticResource CardShadowLayer}" />
                                <Border Style="{StaticResource CardSurface}" Padding="0">
                                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransactionActivityItem">
                                            <SwipeView>
                                                <SwipeView.RightItems>
                                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                                        <SwipeItemView Invoked="OnEditTransactionInvoked">
                                                            <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{DynamicResource Accent}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                                <Path WidthRequest="22" HeightRequest="22" Data="M 4,20 L 8,19 L 19,8 L 16,5 L 5,16 Z M 14,7 L 17,10" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                                <Label Text="Edit" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{DynamicResource AccentForeground}" HorizontalTextAlignment="Center" />
                                                            </VerticalStackLayout>
                                                        </SwipeItemView>
                                                        <SwipeItemView Invoked="OnDeleteTransactionInvoked">
                                                            <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                                <Path WidthRequest="22" HeightRequest="22" Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 7,7 L 8,20 L 16,20 L 17,7 M 10,11 L 10,17 M 14,11 L 14,17" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                                <Label Text="Delete" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                                                            </VerticalStackLayout>
                                                        </SwipeItemView>
                                                    </SwipeItems>
                                                </SwipeView.RightItems>
                                                <Grid RowDefinitions="Auto,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" HandlerChanged="OnTransactionRowHandlerChanged">
                                                    <Grid Padding="14,12" ColumnDefinitions="90,*,Auto" ColumnSpacing="12">
                                                        <Grid ColumnDefinitions="38,14,38">
                                                            <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                                <Image Source="{Binding IconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                            </Border>
                                                            <Label Grid.Column="1" Text="×" Style="{StaticResource BodyMuted}" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                            <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                                <Image Source="{Binding PaymentMethodIconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                            </Border>
                                                        </Grid>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding Description}" Style="{StaticResource CardTitle}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                                                            <Label Text="{Binding DetailText}" Style="{StaticResource BodyMuted}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2" Text="{Binding AmountText}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalTextAlignment="End" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Grid>
                                                    <BoxView Grid.Row="1" Margin="14,0" HeightRequest="1" IsVisible="{Binding ShowDivider}" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                                </Grid>
                                            </SwipeView>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <Grid x:Name="FilterSelectorOverlay" IsVisible="False" Opacity="0" ZIndex="40" SizeChanged="OnFilterSelectorOverlaySizeChanged">
        <BoxView BackgroundColor="#99000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFilterSelectorBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            x:Name="FilterSelectorCard"
            Padding="18,18,18,20"
            WidthRequest="500"
            HeightRequest="520"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.8" Radius="0" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,*" RowSpacing="15">
                <Grid ColumnDefinitions="*,42">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label x:Name="FilterSelectorTitle" Text="Choose a filter" Style="{StaticResource CardTitle}" FontSize="20" />
                        <Label Text="Tap an option to apply it" Style="{StaticResource BodyMuted}" FontSize="12" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" Style="{StaticResource Pill}" Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterSelectorCloseTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="×" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <CollectionView
                    x:Name="FilterSelectorCollection"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="OnFilterSelectorSelectionChanged"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="9" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SelectableTransactionOption">
                            <Border Style="{StaticResource SoftCard}" Padding="10,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentTint}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="48,*,30" ColumnSpacing="13">
                                    <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                        <Image Source="{Binding IconAsset}" WidthRequest="46" HeightRequest="46" Aspect="AspectFill" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                                    <Border Grid.Column="2" WidthRequest="28" HeightRequest="28" IsVisible="{Binding IsSelected}" BackgroundColor="{DynamicResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                        <Path WidthRequest="15" HeightRequest="15" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ContentView>
