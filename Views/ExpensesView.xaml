<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.ExpensesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="22,28,22,126" Spacing="21">
            <!-- Month controls and actions -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label
                        Text="‹"
                        FontSize="31"
                        VerticalTextAlignment="Center"
                        TextColor="{StaticResource SecondaryTextLight}" />
                    <Label
                        Text="September 2026"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        VerticalTextAlignment="Center" />
                    <Label
                        Text="›"
                        FontSize="31"
                        VerticalTextAlignment="Center"
                        TextColor="{StaticResource SecondaryTextLight}" />
                </HorizontalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{StaticResource CardBackgroundLight}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 22">
                    <Label
                        Text="⌕"
                        FontFamily="OpenSansSemibold"
                        FontSize="25"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{StaticResource CardBackgroundLight}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 22">
                    <Label
                        Text="+"
                        FontSize="27"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <Label
                Text="Expenses"
                Style="{StaticResource PageTitle}"
                FontSize="38" />

            <!-- Monthly summary -->
            <Border Style="{StaticResource Card}" Padding="18,17">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Total spending" Style="{StaticResource BodyMuted}" FontSize="12" />
                            <Label
                                Text="RM 1,687.50"
                                FontFamily="OpenSansSemibold"
                                FontSize="27" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label
                                Text="Transaction count"
                                Style="{StaticResource BodyMuted}"
                                FontSize="12"
                                HorizontalTextAlignment="End" />
                            <Label
                                Text="35"
                                FontFamily="OpenSansSemibold"
                                FontSize="28"
                                HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerLight}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label
                            Text="↗"
                            FontSize="16"
                            TextColor="{StaticResource Accent}"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Since last month"
                            Style="{StaticResource BodyMuted}"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="25"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Filters -->
            <HorizontalStackLayout Spacing="9">
                <Border
                    Padding="17,8"
                    BackgroundColor="{StaticResource Accent}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20">
                    <Label Text="All" FontFamily="OpenSansSemibold" TextColor="White" />
                </Border>
                <Border
                    Padding="17,8"
                    BackgroundColor="{StaticResource CardBackgroundLight}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20">
                    <Label Text="Cash" Style="{StaticResource BodyMuted}" />
                </Border>
                <Border
                    Padding="17,8"
                    BackgroundColor="{StaticResource CardBackgroundLight}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20">
                    <Label Text="Online" Style="{StaticResource BodyMuted}" />
                </Border>
            </HorizontalStackLayout>

            <!-- Today -->
            <VerticalStackLayout Spacing="12">
                <Label Text="TODAY" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,15" ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                            <Border
                                WidthRequest="43"
                                HeightRequest="43"
                                BackgroundColor="{StaticResource AccentTintLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">
                                <Label
                                    Text="+"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="21"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Medical card · Maybank"
                                    Style="{StaticResource CardTitle}"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />
                                <Label Text="Health" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="−RM 172.00"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="14"
                                    TextColor="{StaticResource NegativeLight}"
                                    HorizontalTextAlignment="End" />
                                <Label Text="Online" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Margin="74,0,16,0" HeightRequest="1" BackgroundColor="{StaticResource DividerLight}" />

                        <Grid Padding="16,15" ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                            <Border
                                WidthRequest="43"
                                HeightRequest="43"
                                BackgroundColor="{StaticResource MintLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">
                                <Label Text="G" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Groceries from Mydin"
                                    Style="{StaticResource CardTitle}"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />
                                <Label Text="Groceries" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="−RM 38.90"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="14"
                                    TextColor="{StaticResource NegativeLight}"
                                    HorizontalTextAlignment="End" />
                                <Label Text="Online" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Margin="74,0,16,0" HeightRequest="1" BackgroundColor="{StaticResource DividerLight}" />

                        <Grid Padding="16,15" ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                            <Border
                                WidthRequest="43"
                                HeightRequest="43"
                                BackgroundColor="{StaticResource BlushLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">
                                <Label Text="♥" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Family contribution"
                                    Style="{StaticResource CardTitle}"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation" />
                                <Label Text="Other" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="+RM 22.00"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="14"
                                    TextColor="{StaticResource PositiveLight}"
                                    HorizontalTextAlignment="End" />
                                <Label Text="Cash" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Margin="74,0,16,0" HeightRequest="1" BackgroundColor="{StaticResource DividerLight}" />

                        <Grid Padding="16,15" ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                            <Border
                                WidthRequest="43"
                                HeightRequest="43"
                                BackgroundColor="{StaticResource AccentTintLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">
                                <Label Text="T" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Motor fuel · Visa"
                                    Style="{StaticResource CardTitle}"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation" />
                                <Label Text="Transport" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="−RM 8.00"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="14"
                                    TextColor="{StaticResource NegativeLight}"
                                    HorizontalTextAlignment="End" />
                                <Label Text="Online" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Yesterday -->
            <VerticalStackLayout Spacing="12">
                <Label Text="YESTERDAY" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,15" ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                            <Border
                                WidthRequest="43"
                                HeightRequest="43"
                                BackgroundColor="{StaticResource MintLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">
                                <Label Text="G" FontFamily="OpenSansSemibold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Market groceries" Style="{StaticResource CardTitle}" FontSize="14" />
                                <Label Text="Groceries" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="−RM 50.00"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="14"
                                    TextColor="{StaticResource NegativeLight}"
                                    HorizontalTextAlignment="End" />
                                <Label Text="Cash" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Margin="74,0,16,0" HeightRequest="1" BackgroundColor="{StaticResource DividerLight}" />
                        <Grid Padding="16,15" ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                            <Border
                                WidthRequest="43"
                                HeightRequest="43"
                                BackgroundColor="{StaticResource BlushLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">
                                <Label Text="+" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Pharmacy"
                                    Style="{StaticResource CardTitle}"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation" />
                                <Label Text="Health" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="−RM 19.80"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="14"
                                    TextColor="{StaticResource NegativeLight}"
                                    HorizontalTextAlignment="End" />
                                <Label Text="Online" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
