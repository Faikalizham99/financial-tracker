<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FinancialTracker.Views.AssetsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:FinancialTracker.Helpers"
    xmlns:views="clr-namespace:FinancialTracker.Views">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="22,28,22,126" Spacing="21" HorizontalOptions="Fill">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="6" ColumnSpacing="9">
                    <Label
                        Grid.ColumnSpan="{OnIdiom Phone=3, Tablet=1, Desktop=1}"
                        Text="Assets"
                        Style="{StaticResource PageTitle}"
                        FontSize="{OnIdiom Phone=29, Tablet=38, Desktop=38}"
                        FontAutoScalingEnabled="False"
                        LineBreakMode="NoWrap"
                        MaxLines="1"
                        VerticalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                        Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                        Spacing="2"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                    <Border WidthRequest="30" HeightRequest="30" Padding="6" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPreviousMonthTapped" /></Border.GestureRecognizers>
                        <Path Data="M 15,4 L 7,12 L 15,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.3" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" />
                    </Border>
                    <Label x:Name="MonthLabel" FontFamily="OpenSansSemibold" FontSize="13" MinimumWidthRequest="110" HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMonthTapped" /></Label.GestureRecognizers>
                    </Label>
                    <Border WidthRequest="30" HeightRequest="30" Padding="6" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNextMonthTapped" /></Border.GestureRecognizers>
                        <Path Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.3" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" />
                    </Border>
                    </HorizontalStackLayout>

                    <Border
                        Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                        Grid.Column="2"
                        HeightRequest="44"
                        Padding="15,0"
                        Style="{StaticResource Pill}"
                        helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditTapped" /></Border.GestureRecognizers>
                        <Label x:Name="EditActionLabel" Text="Add snapshot" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{DynamicResource Accent}" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <Border x:Name="EmptyCard" Style="{StaticResource Card}" IsVisible="False" MinimumHeightRequest="180">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Padding="8,16">
                        <Label Text="No asset snapshot yet" Style="{StaticResource CardTitle}" HorizontalTextAlignment="Center" />
                        <Label x:Name="EmptyMessageLabel" Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="PortfolioContent" Spacing="22" IsVisible="False">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label x:Name="TotalModeLabel" Text="TOTAL ASSETS" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label x:Name="KwspModeLabel" Text="With KWSP" Style="{StaticResource BodyMuted}" FontFamily="OpenSansSemibold" FontSize="12" VerticalTextAlignment="Center" />
                                    <Border
                                        x:Name="KwspToggleButton"
                                        WidthRequest="50"
                                        HeightRequest="28"
                                        Padding="2"
                                        BackgroundColor="{DynamicResource Accent}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center"
                                        helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                                        SemanticProperties.Description="KWSP included in portfolio totals. Tap to exclude it.">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnKwspToggleTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <Border
                                                x:Name="KwspToggleThumb"
                                                WidthRequest="24"
                                                HeightRequest="24"
                                                Padding="2"
                                                TranslationX="22"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                BackgroundColor="White"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                                <Grid WidthRequest="20" HeightRequest="20">
                                                    <Path
                                                        x:Name="KwspToggleIcon"
                                                        Data="M 4,10 L 20,10 L 18,20 L 6,20 Z M 8,14 L 16,14 M 9,17 L 15,17 M 12,3 C 14.2,3 16,4.8 16,7 C 16,9.2 14.2,11 12,11 C 9.8,11 8,9.2 8,7 C 8,4.8 9.8,3 12,3 Z"
                                                        Stroke="{DynamicResource Accent}"
                                                        StrokeThickness="1.8"
                                                        StrokeLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        Fill="Transparent"
                                                        Aspect="Uniform" />
                                                    <Path
                                                        x:Name="KwspExclusionSlash"
                                                        IsVisible="False"
                                                        Data="M 5,4 L 19,20"
                                                        Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                                        StrokeThickness="2.2"
                                                        StrokeLineCap="Round"
                                                        Fill="Transparent"
                                                        Aspect="Uniform" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="16">
                                <Label
                                    x:Name="TotalLabel"
                                    Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="34"
                                    FontAutoScalingEnabled="False"
                                    LineBreakMode="NoWrap"
                                    MaxLines="1" />
                                <Border
                                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                    Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                                    Style="{StaticResource Pill}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start">
                                    <Label x:Name="TotalChangeLabel" FontFamily="OpenSansSemibold" LineBreakMode="NoWrap" MaxLines="1" />
                                </Border>
                                <Label
                                    x:Name="SnapshotDateLabel"
                                    Grid.Row="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                                    Grid.ColumnSpan="{OnIdiom Phone=2, Tablet=1, Desktop=1}"
                                    Style="{StaticResource BodyMuted}"
                                    LineBreakMode="NoWrap"
                                    MaxLines="1" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="ACCESSIBLE ASSETS" Style="{StaticResource SectionLabel}" />
                                    <Label x:Name="AccessibleLabel" Style="{StaticResource CardTitle}" FontSize="21" FontAutoScalingEnabled="False" LineBreakMode="NoWrap" MaxLines="1" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="ACCESSIBLE CHANGE" Style="{StaticResource SectionLabel}" />
                                    <Label x:Name="AccessibleChangeLabel" Style="{StaticResource CardTitle}" FontSize="21" FontAutoScalingEnabled="False" LineBreakMode="NoWrap" MaxLines="1" />
                                    <Label x:Name="AccessibleChangePercentageLabel" Style="{StaticResource BodyMuted}" FontFamily="OpenSansSemibold" FontSize="12" FontAutoScalingEnabled="False" LineBreakMode="NoWrap" MaxLines="1" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="ACCESSIBLE SHARE" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                                    <Label x:Name="AccessibleShareLabel" Grid.Column="1" Style="{StaticResource BodyMuted}" FontFamily="OpenSansSemibold" FontSize="12" VerticalTextAlignment="Center" />
                                </Grid>
                                <GraphicsView
                                    x:Name="AccessibleShareChart"
                                    HeightRequest="10"
                                    InputTransparent="True"
                                    SemanticProperties.Description="Accessible assets as a share of the displayed portfolio." />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="ASSET COMPARISON" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                HeightRequest="38"
                                Padding="12,0"
                                Style="{StaticResource Pill}"
                                helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                                SemanticProperties.Description="Assets sorted alphabetically. Tap to change the order.">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAssetSortTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                    <Path
                                        WidthRequest="15"
                                        HeightRequest="15"
                                        Data="M 5,3 L 5,15 M 2,6 L 5,3 L 8,6 M 13,15 L 13,3 M 10,12 L 13,15 L 16,12"
                                        Stroke="{DynamicResource Accent}"
                                        StrokeThickness="1.8"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Fill="Transparent"
                                        Aspect="Uniform" />
                                    <Label
                                        x:Name="AssetSortLabel"
                                        Text="A–Z"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12"
                                        TextColor="{DynamicResource Accent}"
                                        VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <VerticalStackLayout x:Name="ComparisonList" Spacing="12" BindableLayout.ItemsSource="{Binding Comparisons}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SoftCard}">
                                        <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14">
                                            <Border WidthRequest="52" HeightRequest="52" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                                <Image Source="{Binding IconAsset}" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                                <Label Text="{Binding ComparisonText}" Style="{StaticResource BodyMuted}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding CurrentText}" FontFamily="OpenSansSemibold" FontSize="16" HorizontalTextAlignment="End" />
                                                <Label Text="{Binding ChangeText}" TextColor="{Binding ChangeColor}" FontFamily="OpenSansSemibold" FontSize="12" HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="14">
                        <Border Style="{StaticResource SoftCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="TREND" Style="{StaticResource SectionLabel}" />
                                <GraphicsView
                                    x:Name="TrendChart"
                                    HeightRequest="82"
                                    InputTransparent="True"
                                    SemanticProperties.Description="Portfolio value trend for up to six months." />
                                <Label x:Name="TrendLabel" Style="{StaticResource BodyMuted}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource SoftCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="PORTFOLIO INSIGHTS" Style="{StaticResource SectionLabel}" />
                                <views:FinancialInsightsView x:Name="AssetInsights" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" IsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" Opacity="0.92" ZIndex="5">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource Accent}" />
                <Label Text="Loading assets…" Style="{StaticResource BodyMuted}" />
            </VerticalStackLayout>
        </Grid>

        <Grid
            x:Name="EditorOverlay"
            IsVisible="False"
            SizeChanged="OnEditorOverlaySizeChanged"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
            ZIndex="20">
            <Grid
                x:Name="EditorContent"
                Padding="{OnIdiom Phone='18,18,18,20', Tablet='24,26,24,26', Desktop='24,26,24,26'}"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="14"
                HorizontalOptions="Center">
                <Grid ColumnDefinitions="*,44" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label x:Name="EditorTitleLabel" Text="Asset snapshot" Style="{StaticResource PageTitle}" FontSize="28" />
                        <HorizontalStackLayout Spacing="2" HorizontalOptions="Start">
                            <Border WidthRequest="28" HeightRequest="28" Padding="7" BackgroundColor="Transparent" StrokeThickness="0" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPreviousEditorMonthTapped" /></Border.GestureRecognizers>
                                <Path Data="M 15,4 L 7,12 L 15,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" />
                            </Border>
                            <Border HeightRequest="28" Padding="10,0" BackgroundColor="Transparent" StrokeThickness="0" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditorMonthTapped" /></Border.GestureRecognizers>
                                <Label x:Name="EditorMonthLabel" Style="{StaticResource BodyMuted}" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center" InputTransparent="True" />
                            </Border>
                            <Border WidthRequest="28" HeightRequest="28" Padding="7" BackgroundColor="Transparent" StrokeThickness="0" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNextEditorMonthTapped" /></Border.GestureRecognizers>
                                <Path Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" Style="{StaticResource Pill}" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseEditorTapped" /></Border.GestureRecognizers>
                        <Label Text="×" FontSize="28" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="10">
                    <Border Style="{StaticResource SoftCard}">
                        <Grid ColumnDefinitions="Auto,*,22" ColumnSpacing="16">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnEntryDateTapped" /></Grid.GestureRecognizers>
                            <Label Text="Entry date" Style="{StaticResource CardTitle}" VerticalTextAlignment="Center" />
                            <Label x:Name="EntryDateLabel" Grid.Column="1" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" VerticalTextAlignment="Center" InputTransparent="True" />
                            <Path Grid.Column="2" WidthRequest="20" HeightRequest="20" Data="M 5,5 L 19,5 Q 21,5 21,7 L 21,19 Q 21,21 19,21 L 5,21 Q 3,21 3,19 L 3,7 Q 3,5 5,5 Z M 3,10 L 21,10 M 8,3 L 8,7 M 16,3 L 16,7" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Enter a value for every asset. Zero is valid." Style="{StaticResource BodyMuted}" />
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                            <Border
                                x:Name="ClearMonthAction"
                                IsVisible="False"
                                Style="{StaticResource Pill}"
                                SemanticProperties.Description="Remove this month's asset snapshot"
                                helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClearMonthTapped" /></Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" InputTransparent="True">
                                    <Path
                                        WidthRequest="15"
                                        HeightRequest="15"
                                        Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 7,7 L 8,21 L 16,21 L 17,7 M 10.5,11 L 10.5,17 M 13.5,11 L 13.5,17"
                                        Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                        StrokeThickness="1.8"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Fill="Transparent"
                                        Aspect="Uniform" />
                                    <Label
                                        Text="Clear month"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Style="{StaticResource Pill}" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCopyPreviousTapped" /></Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" InputTransparent="True">
                                    <Path
                                        WidthRequest="15"
                                        HeightRequest="15"
                                        Data="M 8,7 L 19,7 Q 21,7 21,9 L 21,20 Q 21,22 19,22 L 8,22 Q 6,22 6,20 L 6,9 Q 6,7 8,7 Z M 6,17 L 4,17 Q 2,17 2,15 L 2,4 Q 2,2 4,2 L 15,2 Q 17,2 17,4 L 17,7"
                                        Stroke="{DynamicResource Accent}"
                                        StrokeThickness="1.8"
                                        StrokeLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Fill="Transparent"
                                        Aspect="Uniform" />
                                    <Label Text="Copy previous" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Accent}" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <ScrollView
                    x:Name="EditorAssetsScrollView"
                    Grid.Row="2"
                    ZIndex="0"
                    VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="EditorRows" Padding="0,2" Spacing="12" />
                </ScrollView>

                <VerticalStackLayout
                    Grid.Row="3"
                    ZIndex="5"
                    Spacing="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Portfolio total" Style="{StaticResource CardTitle}" />
                            <Label x:Name="EditorTotalLabel" Grid.Column="1" Style="{StaticResource CardTitle}" TextColor="{DynamicResource Accent}" />
                        </Grid>
                    </Border>
                    <Label x:Name="EditorErrorLabel" TextColor="#C2415A" IsVisible="False" />
                    <Button
                        x:Name="SaveButton"
                        Text="Save snapshot"
                        Clicked="OnSaveClicked"
                        HeightRequest="50"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="{DynamicResource AccentForeground}"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        BorderWidth="0"
                        CornerRadius="17" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <views:MonthYearPickerSheet x:Name="MonthPicker" ZIndex="30" />
    </Grid>
</ContentView>
