<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinancialTracker.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FinancialTracker.Controls"
    xmlns:helpers="clr-namespace:FinancialTracker.Helpers"
    xmlns:models="clr-namespace:FinancialTracker.Models"
    xmlns:views="clr-namespace:FinancialTracker.Views"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="SkeletonLine" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        </Style>

        <DataTemplate x:Key="CategorySummaryTemplate" x:DataType="models:CategorySummaryItem">
            <Grid Padding="0,10" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="42,*,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                <Border Grid.RowSpan="2" WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                    <Image Source="{Binding IconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                </Border>
                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                <Label Grid.Column="2" Text="{Binding AmountText}" FontFamily="OpenSansSemibold" FontSize="12" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                <Label Grid.Column="3" Text="{Binding PercentageText}" Style="{StaticResource BodyMuted}" FontSize="10" MinimumWidthRequest="34" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                <ProgressBar
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    HeightRequest="5"
                    Progress="{Binding Share}"
                    ProgressColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                    <ProgressBar.Triggers>
                        <DataTrigger TargetType="ProgressBar" Binding="{Binding IsIncome}" Value="True">
                            <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                        </DataTrigger>
                    </ProgressBar.Triggers>
                </ProgressBar>
                <BoxView Grid.Row="2" Grid.ColumnSpan="4" HeightRequest="1" IsVisible="{Binding ShowDivider}" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <!-- Dashboard -->
        <ScrollView
            x:Name="DashboardView"
            IsVisible="False"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,30,24,126" Spacing="27">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="5">
                        <Label x:Name="DashboardGreetingLabel" Text="Good morning," Style="{StaticResource DisplayTitle}" />
                        <Label Text="{Binding GreetingName}" Style="{StaticResource DisplayTitle}" />
                        <Label
                            Margin="0,4,0,0"
                            Text="Here’s the shape of your money today."
                            Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        WidthRequest="58"
                        HeightRequest="58"
                        VerticalOptions="Start"
                        BackgroundColor="{DynamicResource Accent}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 29"
                        helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                        SemanticProperties.Description="Open Settings">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="{Binding ProfileInitial}"
                            FontFamily="OpenSansSemibold"
                            FontSize="22"
                            TextColor="{DynamicResource AccentForeground}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="13">
                    <Label Text="MONTHLY PULSE" Style="{StaticResource SectionLabel}" />
                    <views:MonthlySummaryCard x:Name="DashboardMonthlySummary" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="HOME SECTIONS" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                    <Border Grid.Column="1" Padding="11,5" BackgroundColor="{DynamicResource AccentTint}" StrokeThickness="0" StrokeShape="RoundRectangle 999" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnArrangeHomeTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Path WidthRequest="14" HeightRequest="14" Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeLineCap="Round" Fill="Transparent" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Text="Arrange" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{DynamicResource Accent}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout x:Name="DashboardReorderableSections" Spacing="27">
                <VerticalStackLayout x:Name="DashboardGlanceSection" Spacing="13">
                    <Label Text="THIS MONTH AT A GLANCE" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SoftCard}" Padding="16">
                        <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="TodaySpentValueLabel" Text="RM 0.00" FontFamily="OpenSansSemibold" FontSize="{OnIdiom Phone=14, Tablet=17, Desktop=17}" FontAutoScalingEnabled="False" LineBreakMode="TailTruncation" MaxLines="1" HorizontalTextAlignment="Center" />
                                <Label Text="SPENT TODAY" Style="{StaticResource SectionLabel}" FontSize="9" CharacterSpacing="0.7" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="DailyAverageValueLabel" Text="RM 0.00" FontFamily="OpenSansSemibold" FontSize="{OnIdiom Phone=14, Tablet=17, Desktop=17}" FontAutoScalingEnabled="False" LineBreakMode="TailTruncation" MaxLines="1" HorizontalTextAlignment="Center" />
                                <Label Text="DAILY AVERAGE" Style="{StaticResource SectionLabel}" FontSize="9" CharacterSpacing="0.7" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="3" WidthRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                            <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="DaysRemainingValueLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="17" FontAutoScalingEnabled="False" HorizontalTextAlignment="Center" />
                                <Label Text="DAYS LEFT" Style="{StaticResource SectionLabel}" FontSize="9" CharacterSpacing="0.7" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="DashboardInsightSection" Spacing="13">
                    <Label Text="MONTHLY INSIGHT" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SoftCard}" Padding="17">
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="13">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource AccentTint}" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                <Path WidthRequest="22" HeightRequest="22" Data="M 9,18 L 15,18 M 10,21 L 14,21 M 8,14 C 6,12 5,10 5,8 A 7,7 0 0 1 19,8 C 19,10 18,12 16,14 C 15,15 15,16 15,17 L 9,17 C 9,16 9,15 8,14 Z" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="DashboardInsightLabel" Grid.Column="1" Text="Your monthly insight will appear here." FontSize="13" LineHeight="1.25" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="DashboardExpenseCategoriesSection" Spacing="13">
                    <Grid Margin="14,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="EXPENSE CATEGORIES" Style="{StaticResource SectionLabel}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                        <BoxView Grid.Column="1" HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" VerticalOptions="Center" />
                        <Border Grid.Column="2" Padding="10,5" BackgroundColor="{AppThemeBinding Light={StaticResource BlushLight}, Dark={StaticResource BlushDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 999">
                            <Label x:Name="ExpenseCategoryTotalLabel" Text="RM 0.00" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource SoftCard}" Padding="14,2">
                        <VerticalStackLayout
                            x:Name="DashboardExpenseCategoriesLayout"
                            Spacing="0"
                            BindableLayout.ItemTemplate="{StaticResource CategorySummaryTemplate}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="DashboardIncomeCategoriesSection" Spacing="13">
                    <Grid Margin="14,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="INCOME CATEGORIES" Style="{StaticResource SectionLabel}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                        <BoxView Grid.Column="1" HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" VerticalOptions="Center" />
                        <Border Grid.Column="2" Padding="10,5" BackgroundColor="{AppThemeBinding Light={StaticResource MintLight}, Dark={StaticResource MintDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 999">
                            <Label x:Name="IncomeCategoryTotalLabel" Text="RM 0.00" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource SoftCard}" Padding="14,2">
                        <VerticalStackLayout
                            x:Name="DashboardIncomeCategoriesLayout"
                            Spacing="0"
                            BindableLayout.ItemTemplate="{StaticResource CategorySummaryTemplate}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="DashboardRecentActivitySection" Spacing="13">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="RECENT ACTIVITY" Style="{StaticResource SectionLabel}" VerticalTextAlignment="Center" />
                        <Border x:Name="DashboardViewAllButton" Grid.Column="1" Padding="11,5" IsVisible="False" BackgroundColor="{DynamicResource AccentTint}" StrokeThickness="0" StrokeShape="RoundRectangle 999" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDashboardViewAllTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="View all" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{DynamicResource Accent}" />
                        </Border>
                    </Grid>
                    <Border x:Name="DashboardEmptyActivityState" Style="{StaticResource SoftCard}" Padding="22">
                        <Label Text="Your saved transactions will appear here." Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                    </Border>
                    <Grid x:Name="DashboardActivityCard" Margin="0,0,0,6" IsVisible="False">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource CardSurface}" Padding="0">
                            <VerticalStackLayout x:Name="DashboardActivityLayout" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionActivityItem">
                                    <SwipeView>
                                        <SwipeView.Triggers>
                                            <DataTrigger TargetType="SwipeView" Binding="{Binding CanModifyTransaction}" Value="False">
                                                <Setter Property="RightItems">
                                                    <Setter.Value>
                                                        <SwipeItems />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </SwipeView.Triggers>
                                        <SwipeView.RightItems>
                                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                                <SwipeItemView Invoked="OnDashboardEditTransactionInvoked">
                                                    <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{DynamicResource Accent}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                        <Path WidthRequest="22" HeightRequest="22" Data="M 4,20 L 8,19 L 19,8 L 16,5 L 5,16 Z M 14,7 L 17,10" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                        <Label Text="Edit" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{DynamicResource AccentForeground}" HorizontalTextAlignment="Center" />
                                                    </VerticalStackLayout>
                                                </SwipeItemView>
                                                <SwipeItemView Invoked="OnDashboardDeleteTransactionInvoked">
                                                    <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                        <Path WidthRequest="22" HeightRequest="22" Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 7,7 L 8,20 L 16,20 L 17,7 M 10,11 L 10,17 M 14,11 L 14,17" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                        <Label Text="Delete" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                                                    </VerticalStackLayout>
                                                </SwipeItemView>
                                            </SwipeItems>
                                        </SwipeView.RightItems>
                                        <Grid ClassId="TransactionContextMenuTarget" RowDefinitions="Auto,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" HandlerChanged="OnDashboardTransactionRowHandlerChanged">
                                            <Grid Padding="14,12" ColumnDefinitions="90,*,Auto" ColumnSpacing="12">
                                                <Grid ColumnDefinitions="38,14,38">
                                                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                        <Image Source="{Binding IconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                    </Border>
                                                    <Label Grid.Column="1" Text="×" Style="{StaticResource BodyMuted}" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                        <Image Source="{Binding PaymentMethodIconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                    </Border>
                                                </Grid>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Description}" Style="{StaticResource CardTitle}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <Label Text="{Binding DashboardDetailText}" Style="{StaticResource BodyMuted}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                                                    <Label Text="{Binding AmountText}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Text="{Binding DashboardDateText}" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" LineBreakMode="NoWrap" MaxLines="1" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <BoxView Grid.Row="1" Margin="14,0" HeightRequest="1" IsVisible="{Binding ShowDivider}" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                        </Grid>
                                    </SwipeView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Expenses is the initial screen. -->
        <views:ExpensesView x:Name="ExpensesView" />

        <views:SettingsView x:Name="SettingsView" IsVisible="False" />

        <!-- Displayed only when the app has no cached transaction data yet. -->
        <Grid
            x:Name="DataLoadingOverlay"
            IsVisible="True"
            Opacity="1"
            ZIndex="20"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
            SemanticProperties.Description="Loading financial data">
            <Grid x:Name="DataLoadingSkeletonPulseLayer">
                <ScrollView x:Name="HomeLoadingSkeleton" IsVisible="False" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="24,30,24,126" Spacing="27">
                        <Grid ColumnDefinitions="*,58" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="9">
                                <Border Style="{StaticResource SkeletonLine}" WidthRequest="210" HeightRequest="25" HorizontalOptions="Start" />
                                <Border Style="{StaticResource SkeletonLine}" WidthRequest="140" HeightRequest="25" HorizontalOptions="Start" />
                                <Border Margin="0,7,0,0" Style="{StaticResource SkeletonLine}" WidthRequest="235" HeightRequest="11" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="58" HeightRequest="58" BackgroundColor="{DynamicResource AccentTint}" StrokeThickness="0" StrokeShape="RoundRectangle 29" />
                        </Grid>

                        <VerticalStackLayout Spacing="13">
                            <Border Style="{StaticResource SkeletonLine}" WidthRequest="105" HeightRequest="10" HorizontalOptions="Start" />
                            <Border HeightRequest="258" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 28">
                                <VerticalStackLayout Padding="20" Spacing="18">
                                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="180" HeightRequest="15" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="250" HeightRequest="42" HorizontalOptions="Start" />
                                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="195" HeightRequest="14" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                                        <Border Style="{StaticResource SkeletonLine}" HeightRequest="42" />
                                        <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" HeightRequest="42" />
                                        <Border Grid.Column="2" Style="{StaticResource SkeletonLine}" HeightRequest="42" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="13">
                            <Border Style="{StaticResource SkeletonLine}" WidthRequest="150" HeightRequest="10" HorizontalOptions="Start" />
                            <Border HeightRequest="115" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 22" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView x:Name="TransactionLoadingSkeleton" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="24,30,24,126" Spacing="25">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <Border Style="{StaticResource SkeletonLine}" WidthRequest="185" HeightRequest="31" HorizontalOptions="Start" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                <Border Style="{StaticResource SkeletonLine}" WidthRequest="118" HeightRequest="16" VerticalOptions="Center" />
                                <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 22" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Border HeightRequest="268" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 28">
                            <VerticalStackLayout Padding="20" Spacing="18">
                                <Border Style="{StaticResource SkeletonLine}" WidthRequest="180" HeightRequest="15" HorizontalOptions="Start" />
                                <Border Style="{StaticResource SkeletonLine}" WidthRequest="250" HeightRequest="42" HorizontalOptions="Start" />
                                <Border Style="{StaticResource SkeletonLine}" WidthRequest="195" HeightRequest="14" HorizontalOptions="Start" />
                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                    <Border Style="{StaticResource SkeletonLine}" HeightRequest="48" />
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" HeightRequest="48" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="13">
                            <Border Style="{StaticResource SkeletonLine}" WidthRequest="72" HeightRequest="10" HorizontalOptions="Start" />
                            <Border HeightRequest="112" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 22" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="13">
                            <Border Style="{StaticResource SkeletonLine}" WidthRequest="135" HeightRequest="10" HorizontalOptions="Start" />
                            <Border HeightRequest="150" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 24" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

        </Grid>

        <!-- Bottom dock: navigation and a separate add button. -->
        <Grid
            x:Name="BottomNavigationDock"
            Margin="18,0,18,18"
            ColumnDefinitions="*,70"
            ColumnSpacing="11"
            ZIndex="30"
            VerticalOptions="End">
            <Border
                Grid.Column="0"
                HeightRequest="70"
                Padding="7"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 35">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.18" Radius="16" />
                </Border.Shadow>
                <Grid
                    x:Name="NavigationTabsGrid"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="4"
                    SizeChanged="OnNavigationTabsSizeChanged">
                    <Border
                        x:Name="NavigationSelectionPill"
                        Grid.Column="1"
                        ZIndex="0"
                        InputTransparent="True"
                        BackgroundColor="{DynamicResource AccentTint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 23" />
                    <Border x:Name="DashboardTab" ZIndex="1" Style="{StaticResource NavTab}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDashboardTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Path
                                x:Name="DashboardIcon"
                                Data="M 3,11 L 12,3 L 21,11 L 21,21 L 14,21 L 14,14 L 10,14 L 10,21 L 3,21 Z"
                                Style="{StaticResource NavIcon}" />
                            <Label x:Name="DashboardLabel" Text="Home" Style="{StaticResource NavLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="ExpensesTab" Grid.Column="1" ZIndex="1" Style="{StaticResource NavTab}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpensesTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Path
                                x:Name="ExpensesIcon"
                                Data="M 3,7 L 17,7 L 14,4 L 16,2 L 22,8 L 16,14 L 14,12 L 17,9 L 3,9 Z M 21,17 L 7,17 L 10,14 L 8,12 L 2,18 L 8,24 L 10,22 L 7,19 L 21,19 Z"
                                Style="{StaticResource SelectedNavIcon}" />
                            <Label x:Name="ExpensesLabel" Text="Transactions" Style="{StaticResource SelectedNavLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="SettingsTab" Grid.Column="2" ZIndex="1" Style="{StaticResource NavTab}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Path
                                x:Name="SettingsIcon"
                                Data="M 3,5 L 15,5 L 15,3 L 17,3 L 17,5 L 21,5 L 21,7 L 17,7 L 17,9 L 15,9 L 15,7 L 3,7 Z M 3,11 L 7,11 L 7,9 L 9,9 L 9,11 L 21,11 L 21,13 L 9,13 L 9,15 L 7,15 L 7,13 L 3,13 Z M 3,17 L 12,17 L 12,15 L 14,15 L 14,17 L 21,17 L 21,19 L 14,19 L 14,21 L 12,21 L 12,19 L 3,19 Z"
                                Style="{StaticResource NavIcon}" />
                            <Label x:Name="SettingsLabel" Text="Settings" Style="{StaticResource NavLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <Border
                x:Name="AddButton"
                Grid.Column="1"
                WidthRequest="68"
                HeightRequest="68"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 34"
                helpers:InteractionAnimations.IsPressFeedbackEnabled="True"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTapped" />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.18" Radius="16" />
                </Border.Shadow>
                <Label
                    Text="+"
                    FontSize="35"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <views:AddTransactionView
            x:Name="AddTransactionOverlay"
            IsVisible="False"
            ZIndex="100" />

        <views:TransactionSearchView
            x:Name="TransactionSearchView"
            ZIndex="110" />

        <views:CalendarDatePickerSheet
            x:Name="CalendarPicker"
            ZIndex="130" />

        <Grid
            x:Name="ArrangeHomeOverlay"
            IsVisible="False"
            Opacity="0"
            ZIndex="115">
            <BoxView BackgroundColor="{StaticResource OverlayScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnArrangeHomeBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="ArrangeHomeCard"
                Margin="18"
                Padding="20"
                MaximumWidthRequest="500"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 28">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.8" Radius="0" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*,42">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="Arrange Home" Style="{StaticResource CardTitle}" FontSize="20" />
                            <Label Text="Drag rows to reorder. Monthly Pulse stays at the top." Style="{StaticResource BodyMuted}" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" Style="{StaticResource Pill}" Padding="0" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArrangeHomeCloseTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="×" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SoftCard}" Padding="12,2">
                        <VerticalStackLayout x:Name="ArrangeHomeSectionsLayout" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeSectionOption">
                                    <controls:ReorderableSectionRow
                                        RowDefinitions="52,Auto"
                                        ColumnDefinitions="34,*"
                                        ColumnSpacing="10"
                                        VerticalDragUpdated="OnHomeSectionDragUpdated">
                                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="{DynamicResource AccentTint}" StrokeThickness="0" StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                                            <Path WidthRequest="16" HeightRequest="16" Data="M 4,5 L 12,5 M 4,8 L 12,8 M 4,11 L 12,11" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" IsVisible="{Binding ShowDivider}" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                    </controls:ReorderableSectionRow>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="10">
                        <Border Padding="14,0" HeightRequest="50" Style="{StaticResource Pill}" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArrangeHomeResetTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Reset" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" HeightRequest="50" Style="{StaticResource Pill}" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArrangeHomeCloseTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Cancel" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" HeightRequest="50" BackgroundColor="{DynamicResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 999" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArrangeHomeSaveTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Save" FontFamily="OpenSansSemibold" TextColor="{DynamicResource AccentForeground}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid
            x:Name="DeleteConfirmationOverlay"
            IsVisible="False"
            Opacity="0"
            ZIndex="120"
            SizeChanged="OnDeleteConfirmationOverlaySizeChanged">
            <BoxView BackgroundColor="{StaticResource OverlayScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDeleteConfirmationBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="DeleteConfirmationCard"
                WidthRequest="420"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 28">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,8" Opacity="0.55" Radius="0" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                        <Border
                            WidthRequest="50"
                            HeightRequest="50"
                            BackgroundColor="{AppThemeBinding Light=#FCE8EB, Dark=#43252B}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 17">
                            <Path
                                WidthRequest="24"
                                HeightRequest="24"
                                Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 7,7 L 8,20 L 16,20 L 17,7 M 10,11 L 10,17 M 14,11 L 14,17"
                                Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                StrokeThickness="2"
                                StrokeLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"
                                Aspect="Uniform"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Delete transaction?" Style="{StaticResource CardTitle}" FontSize="22" VerticalTextAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="48,18,48" HorizontalOptions="Start">
                        <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                            <Image x:Name="DeleteCategoryIcon" WidthRequest="48" HeightRequest="48" Aspect="AspectFill" />
                        </Border>
                        <Label Grid.Column="1" Text="×" Style="{StaticResource BodyMuted}" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Border Grid.Column="2" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                            <Image x:Name="DeletePaymentMethodIcon" WidthRequest="48" HeightRequest="48" Aspect="AspectFill" />
                        </Border>
                    </Grid>

                    <Label x:Name="DeleteDescriptionLabel" Text="This transaction will be permanently removed." Style="{StaticResource BodyMuted}" FontSize="13" LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Pill}" HeightRequest="52" Padding="16,0" helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteConfirmationCancelTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Cancel" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border
                            x:Name="DeleteConfirmButton"
                            Grid.Column="1"
                            HeightRequest="52"
                            Padding="16,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            helpers:InteractionAnimations.IsPressFeedbackEnabled="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteConfirmationConfirmedTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="DeleteConfirmLabel" Text="Delete" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Border
            x:Name="TransactionLockToast"
            IsVisible="False"
            Opacity="0"
            TranslationY="10"
            ZIndex="150"
            Margin="22,0,22,104"
            Padding="14,11"
            MaximumWidthRequest="390"
            HorizontalOptions="Center"
            VerticalOptions="End"
            InputTransparent="True"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
            Stroke="{DynamicResource Accent}"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 18">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,5" Opacity="0.3" Radius="12" />
            </Border.Shadow>
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
                <Path
                    x:Name="TransactionLockedToastIcon"
                    WidthRequest="18"
                    HeightRequest="20"
                    Data="M 6,10 L 6,7 A 6,6 0 0 1 18,7 L 18,10 M 5,10 L 19,10 L 19,21 L 5,21 Z M 12,14 L 12,17"
                    Stroke="{DynamicResource Accent}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Fill="Transparent"
                    Aspect="Uniform"
                    VerticalOptions="Center" />
                <Path
                    x:Name="TransactionEditingToastIcon"
                    IsVisible="False"
                    WidthRequest="19"
                    HeightRequest="19"
                    Data="M 4,20 L 8,19 L 19,8 L 16,5 L 5,16 Z M 14,7 L 17,10"
                    Stroke="{DynamicResource Accent}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeLineJoin="Round"
                    Fill="Transparent"
                    Aspect="Uniform"
                    VerticalOptions="Center" />
                <Label
                    x:Name="TransactionLockToastLabel"
                    Grid.Column="1"
                    Text="Transactions locked"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    LineBreakMode="NoWrap"
                    MaxLines="1"
                    VerticalTextAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
