<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinancialTracker.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FinancialTracker.Models"
    xmlns:views="clr-namespace:FinancialTracker.Views"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Dashboard -->
        <ScrollView
            x:Name="DashboardView"
            IsVisible="False"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,30,24,126" Spacing="27">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Good morning," Style="{StaticResource DisplayTitle}" />
                        <Label Text="{Binding GreetingName}" Style="{StaticResource DisplayTitle}" />
                        <Label
                            Margin="0,4,0,0"
                            Text="Here’s the shape of your money today."
                            Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        WidthRequest="58"
                        HeightRequest="58"
                        VerticalOptions="Start"
                        BackgroundColor="{DynamicResource Accent}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 29">
                        <Label
                            Text="F"
                            FontFamily="OpenSansSemibold"
                            FontSize="22"
                            TextColor="{DynamicResource AccentForeground}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="13">
                    <Label Text="MONTHLY PULSE" Style="{StaticResource SectionLabel}" />
                    <views:MonthlySummaryCard x:Name="DashboardMonthlySummary" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="13">
                    <Label Text="RECENT ACTIVITY" Style="{StaticResource SectionLabel}" />
                    <Border x:Name="DashboardEmptyActivityState" Style="{StaticResource SoftCard}" Padding="22">
                        <Label Text="Your saved transactions will appear here." Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                    </Border>
                    <Grid x:Name="DashboardActivityCard" Margin="0,0,0,6" IsVisible="False">
                        <Border Style="{StaticResource CardShadowLayer}" />
                        <Border Style="{StaticResource CardSurface}" Padding="0">
                            <VerticalStackLayout x:Name="DashboardActivityLayout" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionActivityItem">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                                <SwipeItemView Invoked="OnDashboardEditTransactionInvoked">
                                                    <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{DynamicResource Accent}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                        <Path WidthRequest="22" HeightRequest="22" Data="M 4,20 L 8,19 L 19,8 L 16,5 L 5,16 Z M 14,7 L 17,10" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                        <Label Text="Edit" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{DynamicResource AccentForeground}" HorizontalTextAlignment="Center" />
                                                    </VerticalStackLayout>
                                                </SwipeItemView>
                                                <SwipeItemView Invoked="OnDashboardDeleteTransactionInvoked">
                                                    <VerticalStackLayout WidthRequest="84" Padding="0,10" Spacing="4" BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                        <Path WidthRequest="22" HeightRequest="22" Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 7,7 L 8,20 L 16,20 L 17,7 M 10,11 L 10,17 M 14,11 L 14,17" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" />
                                                        <Label Text="Delete" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                                                    </VerticalStackLayout>
                                                </SwipeItemView>
                                            </SwipeItems>
                                        </SwipeView.RightItems>
                                        <Grid RowDefinitions="Auto,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" HandlerChanged="OnDashboardTransactionRowHandlerChanged">
                                            <Grid Padding="14,12" ColumnDefinitions="90,*,Auto" ColumnSpacing="12">
                                                <Grid ColumnDefinitions="38,14,38">
                                                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                        <Image Source="{Binding IconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                    </Border>
                                                    <Label Grid.Column="1" Text="×" Style="{StaticResource BodyMuted}" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                                        <Image Source="{Binding PaymentMethodIconAsset}" WidthRequest="38" HeightRequest="38" Aspect="AspectFill" />
                                                    </Border>
                                                </Grid>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Description}" Style="{StaticResource CardTitle}" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <Label Text="{Binding DashboardDetailText}" Style="{StaticResource BodyMuted}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                                                    <Label Text="{Binding AmountText}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" HorizontalTextAlignment="End">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label Text="{Binding DashboardDateText}" Style="{StaticResource BodyMuted}" FontSize="11" HorizontalTextAlignment="End" LineBreakMode="NoWrap" MaxLines="1" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <BoxView Grid.Row="1" Margin="14,0" HeightRequest="1" IsVisible="{Binding ShowDivider}" BackgroundColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                                        </Grid>
                                    </SwipeView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Expenses is the initial screen. -->
        <views:ExpensesView x:Name="ExpensesView" />

        <!-- Settings -->
        <ScrollView
            x:Name="LegacySettingsView"
            IsVisible="False"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,30,24,126" Spacing="27">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Settings" Style="{StaticResource PageTitle}" />
                    <Label Text="Make Financial Tracker feel like yours." Style="{StaticResource BodyMuted}" />
                </VerticalStackLayout>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                        <Border
                            WidthRequest="56"
                            HeightRequest="56"
                            BackgroundColor="{DynamicResource Accent}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28">
                            <Label Text="F" FontFamily="OpenSansSemibold" FontSize="21" TextColor="{DynamicResource AccentForeground}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Faikal" Style="{StaticResource CardTitle}" />
                            <Label Text="MYR · Malaysian Ringgit" Style="{StaticResource BodyMuted}" FontSize="12" />
                        </VerticalStackLayout>
                        <Path Grid.Column="2" WidthRequest="18" HeightRequest="18" Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <VerticalStackLayout Spacing="13">
                    <Label Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SoftCard}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Theme" Style="{StaticResource CardTitle}" FontSize="16" />
                                    <Label Text="Light mode is selected" Style="{StaticResource BodyMuted}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Light" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Accent}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Style="{StaticResource Pill}">
                                    <Label Text="System" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{DynamicResource AccentTint}">
                                    <Label Text="Light" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Accent}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Pill}">
                                    <Label Text="Dark" HorizontalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="13">
                    <Label Text="PREFERENCES" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid Padding="18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="{DynamicResource AccentTint}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13">
                                <Label Text="RM" FontFamily="OpenSansSemibold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Currency" Style="{StaticResource CardTitle}" FontSize="15" />
                                <Label Text="Malaysian Ringgit" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Path Grid.Column="2" WidthRequest="18" HeightRequest="18" Data="M 7,4 L 15,12 L 7,20" Stroke="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <views:SettingsView x:Name="SettingsView" IsVisible="False" />

        <!-- Bottom dock: navigation and a separate add button. -->
        <Grid
            Margin="18,0,18,18"
            ColumnDefinitions="*,70"
            ColumnSpacing="11"
            VerticalOptions="End">
            <Border
                Grid.Column="0"
                HeightRequest="70"
                Padding="7"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 35">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.18" Radius="16" />
                </Border.Shadow>
                <Grid
                    x:Name="NavigationTabsGrid"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="4"
                    SizeChanged="OnNavigationTabsSizeChanged">
                    <Border
                        x:Name="NavigationSelectionPill"
                        Grid.Column="1"
                        ZIndex="0"
                        InputTransparent="True"
                        BackgroundColor="{DynamicResource AccentTint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 23" />
                    <Border x:Name="DashboardTab" ZIndex="1" Style="{StaticResource NavTab}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDashboardTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Path
                                x:Name="DashboardIcon"
                                Data="M 3,11 L 12,3 L 21,11 L 21,21 L 14,21 L 14,14 L 10,14 L 10,21 L 3,21 Z"
                                Style="{StaticResource NavIcon}" />
                            <Label x:Name="DashboardLabel" Text="Home" Style="{StaticResource NavLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="ExpensesTab" Grid.Column="1" ZIndex="1" Style="{StaticResource NavTab}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpensesTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Path
                                x:Name="ExpensesIcon"
                                Data="M 3,7 L 17,7 L 14,4 L 16,2 L 22,8 L 16,14 L 14,12 L 17,9 L 3,9 Z M 21,17 L 7,17 L 10,14 L 8,12 L 2,18 L 8,24 L 10,22 L 7,19 L 21,19 Z"
                                Style="{StaticResource SelectedNavIcon}" />
                            <Label x:Name="ExpensesLabel" Text="Transaction" Style="{StaticResource SelectedNavLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="SettingsTab" Grid.Column="2" ZIndex="1" Style="{StaticResource NavTab}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Path
                                x:Name="SettingsIcon"
                                Data="M 3,5 L 15,5 L 15,3 L 17,3 L 17,5 L 21,5 L 21,7 L 17,7 L 17,9 L 15,9 L 15,7 L 3,7 Z M 3,11 L 7,11 L 7,9 L 9,9 L 9,11 L 21,11 L 21,13 L 9,13 L 9,15 L 7,15 L 7,13 L 3,13 Z M 3,17 L 12,17 L 12,15 L 14,15 L 14,17 L 21,17 L 21,19 L 14,19 L 14,21 L 12,21 L 12,19 L 3,19 Z"
                                Style="{StaticResource NavIcon}" />
                            <Label x:Name="SettingsLabel" Text="Settings" Style="{StaticResource NavLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <Border
                x:Name="AddButton"
                Grid.Column="1"
                WidthRequest="68"
                HeightRequest="68"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 34"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTapped" />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,7" Opacity="0.18" Radius="16" />
                </Border.Shadow>
                <Label
                    Text="+"
                    FontSize="35"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <views:AddTransactionView
            x:Name="AddTransactionOverlay"
            IsVisible="False"
            ZIndex="100" />

        <Grid
            x:Name="DeleteConfirmationOverlay"
            IsVisible="False"
            Opacity="0"
            ZIndex="120"
            SizeChanged="OnDeleteConfirmationOverlaySizeChanged">
            <BoxView BackgroundColor="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDeleteConfirmationBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                x:Name="DeleteConfirmationCard"
                WidthRequest="420"
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 28">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}" Offset="0,8" Opacity="0.55" Radius="0" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                        <Border
                            WidthRequest="50"
                            HeightRequest="50"
                            BackgroundColor="{AppThemeBinding Light=#FCE8EB, Dark=#43252B}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 17">
                            <Path
                                WidthRequest="24"
                                HeightRequest="24"
                                Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 7,7 L 8,20 L 16,20 L 17,7 M 10,11 L 10,17 M 14,11 L 14,17"
                                Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                StrokeThickness="2"
                                StrokeLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"
                                Aspect="Uniform"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Delete transaction?" Style="{StaticResource CardTitle}" FontSize="22" VerticalTextAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="48,18,48" HorizontalOptions="Start">
                        <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                            <Image x:Name="DeleteCategoryIcon" WidthRequest="48" HeightRequest="48" Aspect="AspectFill" />
                        </Border>
                        <Label Grid.Column="1" Text="×" Style="{StaticResource BodyMuted}" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Border Grid.Column="2" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                            <Image x:Name="DeletePaymentMethodIcon" WidthRequest="48" HeightRequest="48" Aspect="AspectFill" />
                        </Border>
                    </Grid>

                    <Label x:Name="DeleteDescriptionLabel" Text="This transaction will be permanently removed." Style="{StaticResource BodyMuted}" FontSize="13" LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Pill}" HeightRequest="52" Padding="16,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteConfirmationCancelTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Cancel" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border
                            x:Name="DeleteConfirmButton"
                            Grid.Column="1"
                            HeightRequest="52"
                            Padding="16,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteConfirmationConfirmedTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="DeleteConfirmLabel" Text="Delete" FontFamily="OpenSansSemibold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
